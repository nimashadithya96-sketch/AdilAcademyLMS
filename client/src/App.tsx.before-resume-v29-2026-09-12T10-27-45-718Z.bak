            to="/login"
            className="button button-small"
            onClick={() => setOpen(false)}
          >
            දැන් ආරම්භ කරන්න
          </Link>
        </nav>
      </div>
    </header>
  );
}

type PublicCourseDetail = {
  course: { title: string; shortDescription: string; price: string; currency: string; language: string };
  enrolledStudents: number;
  sections: Array<{ id: string; title: string; lessons: Array<{ id: string; title: string }> }>;
};
type PublicCourseCard = { id: string; slug: string; title: string; shortDescription: string; description: string | null; price: string; currency: string; thumbnailUrl: string | null };

function courseThumbnailSrc(course: { id: string; thumbnailUrl: string | null }) {
  return course.thumbnailUrl
    ? `/api/courses/${encodeURIComponent(course.id)}/thumbnail?v=${encodeURIComponent(course.thumbnailUrl)}`
    : "";
}

