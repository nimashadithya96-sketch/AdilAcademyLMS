courseRouter.get(
  "/student/dashboard-summary",
  asyncRoute(async (request, response) => {
    const user = await requireAuthenticatedUser(request);
    const db = requireDatabase();
    const [account] = await db.select().from(networkAccounts).where(
      and(
        eq(networkAccounts.ownerUserId, user.id),
        eq(networkAccounts.isMainAccount, true)
      )
    ).limit(1);
    const [enrollment] = await db.select({
      id: enrollments.id,
      status: enrollments.status,
      courseId: enrollments.courseId,
      courseTitle: courses.title,
      halfPaymentLessonLimit: courses.halfPaymentLessonLimit
    }).from(enrollments)
      .innerJoin(courses, eq(enrollments.courseId, courses.id))
      .where(eq(enrollments.userId, user.id))
      .orderBy(asc(enrollments.enrolledAt)).limit(1);

    if (!enrollment) {
      response.json({
        enrollmentStatus: "NOT_ENROLLED",
        enrollmentId: null,
        courseTitle: null,
        totalLessons: 0,
        completedLessons: 0,
        progressPercent: 0,
        quizAverage: null,
        accountNumber: account ? `${account.prefix}${account.numericPart}` : null,
        accountStatus: account?.status ?? null,
        modules: [],
        recentActivity: []
      });
      return;
    }

    const access = await courseAccess(db, user.id, enrollment.courseId);
    const sections = await db.select({ id: courseSections.id, title: courseSections.title, position: courseSections.position })
      .from(courseSections).where(eq(courseSections.courseId, enrollment.courseId)).orderBy(asc(courseSections.position));
    const sectionIds = sections.map((item) => item.id);
    const unorderedLessons = sectionIds.length
      ? await db.select({ id: lessons.id, title: lessons.title, sectionId: lessons.sectionId, position: lessons.position }).from(lessons)
          .where(inArray(lessons.sectionId, sectionIds)).orderBy(asc(lessons.position))
      : [];
    const sectionOrder = new Map(sections.map((section, index) => [section.id, index]));
    const courseLessons = [...unorderedLessons].sort((a, b) =>
      (sectionOrder.get(a.sectionId) ?? 0) - (sectionOrder.get(b.sectionId) ?? 0) || a.position - b.position
    );
    const lessonOrder = new Map(courseLessons.map((lesson, index) => [lesson.id, index]));
    const learningAccessActive = enrollment.status === "ACTIVE" || enrollment.status === "COMPLETED";
    const unlockedLimit = learningAccessActive
      ? access.accessLevel === "FULL" ? courseLessons.length : access.halfPaymentLessonLimit
      : 0;
    const progress = await db.select().from(lessonProgress)
      .where(eq(lessonProgress.enrollmentId, enrollment.id))
      .orderBy(asc(lessonProgress.updatedAt));
    const completed = progress.filter((item) => item.progressPercent === 100);
    const progressByLesson = new Map(progress.map((item) => [item.lessonId, item.progressPercent]));
    const attempts = await db.select({ score: quizAttempts.scorePercent })
      .from(quizAttempts).innerJoin(quizzes, eq(quizAttempts.quizId, quizzes.id))
      .where(and(eq(quizAttempts.userId, user.id), eq(quizzes.courseId, enrollment.courseId)));
    const quizAverage = attempts.length
      ? Math.round(attempts.reduce((sum, item) => sum + item.score, 0) / attempts.length)
      : null;
    const lessonTitles = new Map(courseLessons.map((item) => [item.id, item.title]));
    const completedIds = new Set(completed.map((item) => item.lessonId));
    const modules = sections.map((section) => {
      const moduleLessons = courseLessons.filter((lesson) => lesson.sectionId === section.id);
      const moduleCompleted = moduleLessons.filter((lesson) => completedIds.has(lesson.id)).length;
      return {
        title: section.title,
        totalLessons: moduleLessons.length,
        completedLessons: moduleCompleted,
        progressPercent: moduleLessons.length
          ? Math.round((moduleCompleted / moduleLessons.length) * 100)
          : 0,
        lessons: moduleLessons.map((lesson) => ({
          id: lesson.id,
          title: lesson.title,
          locked: (lessonOrder.get(lesson.id) ?? 0) >= unlockedLimit,
          progressPercent: progressByLesson.get(lesson.id) ?? 0
        }))
      };
    });
    const recentActivity = [...progress].reverse().slice(0, 3).map((item) => ({
      title: lessonTitles.get(item.lessonId) ?? "Course lesson",
      detail: item.progressPercent === 100 ? "Completed" : `${item.progressPercent}% watched`
    }));

    response.json({
      enrollmentStatus: enrollment.status,
      enrollmentId: enrollment.id,
      courseTitle: enrollment.courseTitle,
      totalLessons: courseLessons.length,
      completedLessons: completed.length,
      progressPercent: courseLessons.length
        ? Math.round((completed.length / courseLessons.length) * 100)
        : 0,
      quizAverage,
      accountNumber: account ? `${account.prefix}${account.numericPart}` : null,
      accountStatus: account?.status ?? null,
      accessLevel: access.accessLevel,
      halfPaymentLessonLimit: access.halfPaymentLessonLimit,
      unlockedLessons: unlockedLimit,
      modules,
      recentActivity
    });
  })
);

courseRouter.get(
  "/student/lessons/:id",
  asyncRoute(async (request, response) => {
    const user = await requireAuthenticatedUser(request);
    const db = requireDatabase();
    const lessonId = String(request.params.id);
    const [record] = await db
      .select({
        enrollmentId: enrollments.id,
        enrollmentStatus: enrollments.status,
        courseId: courses.id,
        courseTitle: courses.title,
        moduleId: courseSections.id,
        moduleTitle: courseSections.title,
        lessonId: lessons.id,
        lessonTitle: lessons.title,
        videoProvider: lessons.videoProvider,
        videoId: lessons.videoId,
        content: lessons.content,
        durationSeconds: lessons.durationSeconds
      })
      .from(lessons)
      .innerJoin(courseSections, eq(lessons.sectionId, courseSections.id))
      .innerJoin(courses, eq(courseSections.courseId, courses.id))
      .innerJoin(
        enrollments,
        and(eq(enrollments.courseId, courses.id), eq(enrollments.userId, user.id))
      )
      .where(
        and(
          eq(lessons.id, lessonId),
          inArray(enrollments.status, ["ACTIVE", "COMPLETED"])
        )
      )
      .limit(1);

    if (!record) throw new HttpError(404, "Active course lesson එක හමු නොවුණා.");

    const access = await courseAccess(db, user.id, record.courseId);
    const sections = await db
      .select({ id: courseSections.id, position: courseSections.position })
      .from(courseSections)
      .where(eq(courseSections.courseId, record.courseId))
      .orderBy(asc(courseSections.position));
    const sectionOrder = new Map(sections.map((section, index) => [section.id, index]));
    const orderedLessons = sections.length
      ? await db
          .select({ id: lessons.id, sectionId: lessons.sectionId, position: lessons.position })
          .from(lessons)
          .where(inArray(lessons.sectionId, sections.map((section) => section.id)))
          .orderBy(asc(lessons.position))
      : [];
    orderedLessons.sort((a, b) =>
      (sectionOrder.get(a.sectionId) ?? 0) - (sectionOrder.get(b.sectionId) ?? 0) ||
      a.position - b.position
    );
    const lessonIndex = orderedLessons.findIndex((item) => item.id === record.lessonId);
    if (lessonIndex < 0) throw new HttpError(404, "Lesson එක course එක තුළ හමු නොවුණා.");
    if (access.accessLevel === "HALF" && lessonIndex >= access.halfPaymentLessonLimit) {
      throw new HttpError(403, "Balance payment approval is required to unlock this lesson.");
    }

    const [progress] = await db
      .select({
        progressPercent: lessonProgress.progressPercent,
        watchedSeconds: lessonProgress.watchedSeconds,
        detectedDurationSeconds: lessonProgress.detectedDurationSeconds
      })
      .from(lessonProgress)
      .where(
        and(
          eq(lessonProgress.enrollmentId, record.enrollmentId),
          eq(lessonProgress.lessonId, record.lessonId)
        )
      )
      .limit(1);

    response.json({
      enrollmentId: record.enrollmentId,
      accessLevel: access.accessLevel,
      lesson: {
        id: record.lessonId,
        title: record.lessonTitle,
        moduleTitle: record.moduleTitle,
        courseTitle: record.courseTitle,
        videoProvider: record.videoProvider,
        videoId: record.videoId,
        content: record.content,
        durationSeconds: record.durationSeconds || progress?.detectedDurationSeconds || 0,
        watchedSeconds: progress?.watchedSeconds ?? 0,
        progressPercent: progress?.progressPercent ?? 0
      }
    });
  })
);

courseRouter.post(
  "/student/progress",
  asyncRoute(async (request, response) => {
    const user = await requireAuthenticatedUser(request);
    const input = progressInput.parse(request.body);
    const db = requireDatabase();

    const [enrollment] = await db
      .select()
      .from(enrollments)
      .where(
        and(
          eq(enrollments.id, input.enrollmentId),
          eq(enrollments.userId, user.id),
          inArray(enrollments.status, ["ACTIVE", "COMPLETED"])
        )
      )
      .limit(1);
    if (!enrollment) {
      response.status(403).json({ message: "Active enrollment required." });
      return;
    }

    const [lesson] = await db
      .select({
        id: lessons.id,
        courseId: courseSections.courseId,
        durationSeconds: lessons.durationSeconds
      })
      .from(lessons)
      .innerJoin(courseSections, eq(lessons.sectionId, courseSections.id))
      .where(eq(lessons.id, input.lessonId))
      .limit(1);
    if (!lesson || lesson.courseId !== enrollment.courseId) {
      response.status(400).json({ message: "Lesson is not in this course." });
      return;
    }

    const access = await courseAccess(db, user.id, enrollment.courseId);
    if (access.accessLevel === "HALF") {
      const sections = await db
        .select({ id: courseSections.id })
        .from(courseSections)
        .where(eq(courseSections.courseId, enrollment.courseId))
        .orderBy(asc(courseSections.position));
      const sectionOrder = new Map(sections.map((section, index) => [section.id, index]));
      const unorderedLessons = sections.length
        ? await db
            .select({ id: lessons.id, sectionId: lessons.sectionId, position: lessons.position })
            .from(lessons)
            .where(inArray(lessons.sectionId, sections.map((section) => section.id)))
            .orderBy(asc(lessons.position))
        : [];
      const orderedLessons = [...unorderedLessons].sort((a, b) =>
        (sectionOrder.get(a.sectionId) ?? 0) - (sectionOrder.get(b.sectionId) ?? 0) ||
        a.position - b.position
      );
      const lessonIndex = orderedLessons.findIndex((item) => item.id === input.lessonId);
      if (lessonIndex < 0 || lessonIndex >= access.halfPaymentLessonLimit) {
        throw new HttpError(403, "Balance payment approval is required to unlock this lesson.");
      }
    }

    let effectiveDurationSeconds = lesson.durationSeconds > 0
      ? lesson.durationSeconds
      : input.durationSeconds;

    if (lesson.durationSeconds <= 0) {
      const [updatedLesson] = await db
        .update(lessons)
        .set({ durationSeconds: input.durationSeconds })
        .where(eq(lessons.id, lesson.id))
        .returning({ durationSeconds: lessons.durationSeconds });
      effectiveDurationSeconds = updatedLesson?.durationSeconds ?? input.durationSeconds;
    }

    const [current] = await db
      .select()
      .from(lessonProgress)
      .where(
        and(
          eq(lessonProgress.enrollmentId, input.enrollmentId),
          eq(lessonProgress.lessonId, input.lessonId)
        )
      )
      .limit(1);

    const now = new Date();
    const elapsedWallSeconds = current?.lastHeartbeatAt
      ? Math.max(0, Math.floor((now.getTime() - current.lastHeartbeatAt.getTime()) / 1000))
      : input.elapsedSeconds;
    const acceptedSeconds = current?.progressPercent === 100
      ? 0
      : Math.min(input.elapsedSeconds, Math.max(0, elapsedWallSeconds + 2));
    const restoredWatchedSeconds = current
      ? Math.max(
          current.watchedSeconds,
          Math.floor((current.progressPercent / 100) * effectiveDurationSeconds)
        )
      : 0;
    const watchedSeconds = Math.min(
      effectiveDurationSeconds,
      restoredWatchedSeconds + acceptedSeconds
    );
    const completed = current?.progressPercent === 100 ||
      watchedSeconds >= Math.max(1, effectiveDurationSeconds - 2);
    const progressPercent = completed
      ? 100
      : Math.max(
          current?.progressPercent ?? 0,
          Math.min(99, Math.floor((watchedSeconds / effectiveDurationSeconds) * 100))
        );
    const completedAt = completed
      ? current?.completedAt ?? now
      : null;

    const [saved] = await db
      .insert(lessonProgress)
      .values({
        enrollmentId: input.enrollmentId,
        lessonId: input.lessonId,
        progressPercent,
        watchedSeconds,
        detectedDurationSeconds: effectiveDurationSeconds,
        lastHeartbeatAt: now,
        completedAt,
        updatedAt: now
      })
      .onConflictDoUpdate({
        target: [lessonProgress.enrollmentId, lessonProgress.lessonId],
        set: {
          progressPercent,
          watchedSeconds,
          detectedDurationSeconds: effectiveDurationSeconds,
          lastHeartbeatAt: now,
          completedAt,
          updatedAt: now
        }
      })
      .returning();

    response.json({
      progress: saved,
      acceptedSeconds,
      durationSeconds: effectiveDurationSeconds
    });
  })
);

