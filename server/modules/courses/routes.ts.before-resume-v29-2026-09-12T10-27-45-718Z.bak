courseRouter.delete(
  "/admin/lessons/:id",
  asyncRoute(async (request, response) => {
    await requireRole(request, ["admin"]);
    const db = requireDatabase();
    const lessonId = String(request.params.id);

    const [existing] = await db
      .select({
        id: lessons.id,
        sectionId: lessons.sectionId,
        resourceObjectKey: lessons.resourceObjectKey
      })
      .from(lessons)
      .where(eq(lessons.id, lessonId))
      .limit(1);

    if (!existing) {
      response.status(404).json({ message: "Lesson not found." });
      return;
    }

    const [deleted] = await db
      .delete(lessons)
      .where(eq(lessons.id, lessonId))
      .returning();

    if (existing.resourceObjectKey) {
      deletePrivateFile(existing.resourceObjectKey).catch((error) =>
        console.warn("Lesson resource cleanup failed", error)
      );
    }

    const [remainingLesson] = await db
      .select({ id: lessons.id })
      .from(lessons)
      .where(eq(lessons.sectionId, existing.sectionId))
      .limit(1);

    let removedEmptyModule = false;

    if (!remainingLesson) {
      await db
        .delete(courseSections)
        .where(eq(courseSections.id, existing.sectionId));

      removedEmptyModule = true;
    }

    response.json({
      success: true,
      message: removedEmptyModule
        ? "Lesson and empty module permanently deleted."
        : "Lesson permanently deleted.",
      lesson: deleted,
      removedEmptyModule
    });
  })
);

