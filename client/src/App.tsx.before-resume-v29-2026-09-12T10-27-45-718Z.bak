function MetricCard({
  label,
  value,
  note,
  icon,
  onClick
}: {
  label: string;
  value: string;
  note: string;
  icon: ReactNode;
  onClick?: () => void;
}) {
  return (
    <article className={`metric-card ${onClick ? "metric-card-clickable" : ""}`} onClick={onClick} role={onClick ? "button" : undefined} tabIndex={onClick ? 0 : undefined} onKeyDown={(event) => { if (onClick && (event.key === "Enter" || event.key === " ")) onClick(); }}>
      <span className="metric-icon">{icon}</span>
      <span>{label}</span>
      <strong>{value}</strong>
      <small>{note}</small>
    </article>
  );
}

function StudentDashboard({ onOpen }: { onOpen: (module: string) => void }) {
  const [summary, setSummary] = useState<StudentDashboardSummary | null>(null);
  const [loadError, setLoadError] = useState(false);
  useEffect(() => {
    fetch("/api/student/dashboard-summary")
      .then(async (response) => {
        if (!response.ok) throw new Error("Summary request failed");
        return response.json() as Promise<StudentDashboardSummary>;
      })
      .then(setSummary)
      .catch(() => setLoadError(true));
  }, []);

  if (loadError) {
    return <section className="dash-card"><h3>Dashboard data load කළ නොහැක</h3><p>Page එක refresh කරන්න.</p></section>;
  }
  if (!summary) {
    return <section className="dash-card"><h3>Dashboard loading...</h3></section>;
  }
  const enrolled = summary.enrollmentStatus !== "NOT_ENROLLED";

  function continueLearning() {
    if (!enrolled) return;
    const lessons = summary!.modules.flatMap((module) => module.lessons ?? []);
    const resumeLesson =
      lessons.find((lesson) => !lesson.locked && lesson.progressPercent > 0 && lesson.progressPercent < 100) ??
      lessons.find((lesson) => !lesson.locked && lesson.progressPercent < 100) ??
      lessons.find((lesson) => !lesson.locked);

    if (resumeLesson) {
      window.sessionStorage.setItem("adil-resume-lesson-id", resumeLesson.id);
    }
    onOpen("My Course");
  }

  return (
    <>
      <div className="metrics-grid">
        <MetricCard
          label="Course Progress"
          value={`${summary.progressPercent}%`}
          note={`${summary.completedLessons} of ${summary.totalLessons} lessons`}
          icon={<TrendingUp />}
        />
        <MetricCard
          label="Learning Streak"
          value={summary.completedLessons ? "Active" : "0 days"}
          note={summary.completedLessons ? "Learning started" : "No activity yet"}
          icon={<Sparkles />}
        />
        <MetricCard
          label="Quiz Average"
          value={summary.quizAverage === null ? "—" : `${summary.quizAverage}%`}
          note={summary.quizAverage === null ? "No quiz attempts" : "Quiz performance"}
          icon={<Award />}
        />
        <MetricCard
          label="Account"
          value={summary.accountNumber ?? "Not assigned"}
          note={summary.accountStatus ?? "Payment pending"}
          icon={<UserCheck />}
        />
      </div>
      <div className="dashboard-grid">
        <section className="dash-card dash-course-card">
          <div className="dash-card-heading">
            <div>
              <span className="eyebrow">{enrolled ? "CONTINUE LEARNING" : "COURSE ACCESS LOCKED"}</span>
              <h3>{summary.courseTitle ?? "Payment approval required"}</h3>
            </div>
            <span>{summary.progressPercent}%</span>
          </div>
          <div
            className={`course-visual ${enrolled ? "course-visual-clickable" : ""}`}
            role={enrolled ? "button" : undefined}
            tabIndex={enrolled ? 0 : undefined}
            onClick={continueLearning}
            onKeyDown={(event) => {
              if (enrolled && (event.key === "Enter" || event.key === " ")) {
                event.preventDefault();
                continueLearning();
              }
            }}
          >
            <span className="course-visual-icon">
              <ShieldCheck />
            </span>
            <div>
              <span>{enrolled ? "YOUR COURSE" : "NOT ENROLLED"}</span>
              <strong>{enrolled ? "ඔබ නතර කළ තැනින් ඉගෙනීම දිගටම කරගෙන යන්න" : "Full payment එක Admin approve කළ පසු lessons unlock වේ"}</strong>
            </div>
            <button
              type="button"
              disabled={!enrolled}
              aria-label="Continue learning"
              onClick={(event) => {
                event.stopPropagation();
                continueLearning();
              }}
            >
              <Play fill="currentColor" />
            </button>
          </div>
          <div className="progress-track large">
            <span style={{ width: `${summary.progressPercent}%` }} />
          </div>
        </section>
        <section className="dash-card">
          <div className="dash-card-heading">
            <h3>Recent activity</h3>
            <button type="button">View all</button>
          </div>
          <div className="activity-list">
            {summary.recentActivity.length ? summary.recentActivity.map((activity) => (
              <div key={`${activity.title}-${activity.detail}`}>
                <span className="activity-dot completed"><Check /></span>
                <p><strong>{activity.title}</strong><small>{activity.detail}</small></p>
              </div>
            )) : <p>No learning activity yet.</p>}
          </div>
        </section>
      </div>
    </>
  );
}

type ConsultantDashboardData = {
  mainAccountNumber: string | null;
  totalIncome: number;
  totalPaid: number;
  upcomingIncome: number;
  availableBalance: number;
  directStudents: number;
  leftPoints: number;
  rightPoints: number;
  accounts: Array<{
    id: string; number: string; status: string; isMain: boolean;
    leftAvailable: number; rightAvailable: number;
    stageOneAchieved: boolean; stageTwoAchieved: boolean;
    nextStage: string; nextPayout: number; income: number;
  }>;
  slots: Array<{
    position: number; number: string; status: string; isMain: boolean; accountId: string | null;
  }>;
  earningChart: Record<"daily" | "weekly" | "monthly", {
    points: Array<{ key: string; label: string; amount: number }>;
    current: number; previous: number; bestAmount: number; bestLabel: string; changePercent: number;
  }>;
};

function ConsultantDashboard({ onOpen }: { onOpen: (module: string) => void }) {
  const [data, setData] = useState<ConsultantDashboardData | null>(null);
  const [earningPeriod, setEarningPeriod] = useState<"daily" | "weekly" | "monthly">("daily");
  const [loadError, setLoadError] = useState(false);
  useEffect(() => {
    fetch("/api/consultant/cco-dashboard")
      .then(async (response) => {
        if (!response.ok) throw new Error("CCO dashboard request failed");
        return response.json() as Promise<ConsultantDashboardData>;
      })
      .then(setData)
      .catch(() => setLoadError(true));
  }, []);
  if (loadError) return <section className="dash-card"><h3>CCO data load කළ නොහැක</h3><p>Page එක refresh කර නැවත උත්සාහ කරන්න.</p></section>;
  if (!data) return <section className="dash-card"><h3>CCO dashboard loading...</h3></section>;
  const dashboardData = data;
  const money = (value: number) => `Rs. ${value.toLocaleString()}`;
  const main = data.accounts.find((account) => account.isMain) ?? data.accounts[0];
  const trend = data.earningChart?.[earningPeriod];
  const maxChartValue = Math.max(1, ...(trend?.points.map((point) => point.amount) ?? [0]));
  const periodName = earningPeriod === "daily" ? "Today" : earningPeriod === "weekly" ? "This week" : "This month";
  const comparisonText = !trend ? "" : trend.previous === 0 && trend.current === 0 ? "No earnings yet" : trend.changePercent >= 0 ? `${trend.changePercent}% higher than previous` : `${Math.abs(trend.changePercent)}% lower than previous`;
  const nextAccountPosition = data.slots.find((item) => !item.accountId)?.position;
  function networkNode(position: number) {
    const slot = dashboardData.slots.find((item) => item.position === position); if (!slot) return null;
    const summary = dashboardData.accounts.find((item) => item.number === slot.number); const active = Boolean(slot.accountId);
    return <div className={`cco-network-node ${active ? "active" : position === nextAccountPosition ? "next" : "locked"}`}>
      <span className="cco-node-position">{position === 1 ? "MAIN" : `ACCOUNT ${position}`}</span>
      <strong>{slot.number}</strong>
      <small>{active ? "ACTIVE" : position === nextAccountPosition ? "NEXT TO BUY" : "LOCKED"}</small>
      {active && <div className="cco-point-pair"><span><b>P</b> LEFT <strong>{summary?.leftAvailable ?? 0}</strong></span><span><b>P</b> RIGHT <strong>{summary?.rightAvailable ?? 0}</strong></span></div>}
    </div>;
  }
  return (
    <>
      <ConsultantAdmissionTargets />
      {trend && <section className="dash-card earning-chart-card">
        <div className="earning-chart-heading">
          <div><span className="eyebrow">EARNING CHART</span><h3>Your income momentum</h3><p>Previous performance එක පරදවා අලුත් personal best එකක් ලබාගන්න.</p></div>
          <div className="earning-period-tabs">
            {(["daily", "weekly", "monthly"] as const).map((period) => <button type="button" key={period} className={earningPeriod === period ? "active" : ""} onClick={() => setEarningPeriod(period)}>{period[0].toUpperCase() + period.slice(1)}</button>)}
          </div>
        </div>
        <div className="earning-comparison-grid">
          <div><small>{periodName}</small><strong>{money(trend.current)}</strong><span className={trend.changePercent >= 0 ? "positive" : "negative"}>{comparisonText}</span></div>
          <div><small>Previous period</small><strong>{money(trend.previous)}</strong><span>Comparison baseline</span></div>
          <div className="personal-best"><small>Personal best</small><strong>{money(trend.bestAmount)}</strong><span>{trend.bestLabel}</span></div>
        </div>
        <div className="earning-bars" aria-label={`${earningPeriod} earnings chart`}>
          {trend.points.map((point, index) => <div className="earning-bar-column" key={point.key} title={`${point.label}: ${money(point.amount)}`}>
            <span className="earning-bar-value">{point.amount ? point.amount >= 1000 ? `${Math.round(point.amount / 100) / 10}k` : point.amount : ""}</span>
            <div className={`earning-bar ${index === trend.points.length - 1 ? "current" : ""}`} style={{ height: `${Math.max(point.amount ? 8 : 2, (point.amount / maxChartValue) * 100)}%` }} />
            <small>{point.label}</small>
          </div>)}
        </div>
        <p className="earning-motivation">{trend.current >= trend.bestAmount && trend.current > 0 ? "🔥 New personal best! මේ momentum එක දිගටම තබාගන්න." : `ඔබගේ best ${earningPeriod} income එක පරදවන්න තවත් ${money(Math.max(0, trend.bestAmount - trend.current))} අවශ්‍යයි.`}</p>
      </section>}
      <div className="dashboard-grid">
        <section className="dash-card">
          <div className="dash-card-heading">
            <div>
              <span className="eyebrow">BINARY NETWORK</span>
              <h3>{data.mainAccountNumber ?? "No CN account"}</h3>
            </div>
            <span className="status-badge success">CCO ACTIVE</span>
          </div>
          <div className="cco-seven-tree">
            <div className="cco-tree-root">{networkNode(1)}</div>
            <div className="cco-tree-level level-two"><div>{networkNode(2)}</div><div>{networkNode(3)}</div></div>
            <div className="cco-tree-level level-three"><div>{networkNode(4)}</div><div>{networkNode(6)}</div><div>{networkNode(7)}</div><div>{networkNode(5)}</div></div>
            <div className="cco-tree-legend"><span><i className="active" /> Active account</span><span><i className="next" /> Next to buy</span><span><i /> Locked</span></div>
          </div>
          {main && <p className="workspace-note">Next cycle: <strong>{main.nextStage}</strong> → {money(main.nextPayout)}</p>}
        </section>
        <section className="dash-card">
          <div className="dash-card-heading">
            <div><span className="eyebrow">7-NUMBER BLOCK</span><h3>My CCO accounts</h3></div>
            <span>{data.accounts.length}/7 active</span>
          </div>
          <div className="account-list">
            {data.slots.map((slot) => { const nextPosition = data.slots.find((item) => !item.accountId)?.position; const available = slot.position === nextPosition; return <button type="button" className={`account-list-item ${available ? "available" : !slot.accountId ? "locked" : ""}`} key={slot.position} onClick={() => { if (slot.accountId) return; if (available) onOpen("CCO Activation"); else window.alert(`මුලින් ${data.slots.find((item) => item.position === nextPosition)?.number ?? "previous account"} activate කරන්න.`); }}>
              <span className={`account-badge ${slot.accountId ? "" : "muted"}`}>{slot.isMain ? "MAIN" : String(slot.position).padStart(2, "0")}</span>
              <p><strong>{slot.number}</strong><small>{slot.accountId ? "Commission cycle enabled" : available ? "Available to buy now" : `Locked • Activate account ${nextPosition} first`}</small></p>
              <span className={`status-badge ${slot.accountId ? "success" : available ? "success" : ""}`}>{slot.accountId ? slot.status : available ? "BUY NOW" : "LOCKED"}</span>
            </button>})}
          </div>
        </section>
      </div>
    </>
  );
}

type ServiceAccount = {
  id: string; position: number; number: string; username: string; status: string;
  leftPoints: number; rightPoints: number;
  weeklyFlush: null | { cycleKey: string; periodStart: string; periodEnd: string; stage: string; matchedPairs: number; leftBefore: number; rightBefore: number; leftFlushed: number; rightFlushed: number; amount: number };
};
type ServiceAccountActivity = { id:string; beneficiaryAccountIds:string[]; beneficiaryAccountNumbers:string[]; side:"LEFT"|"RIGHT"; studentName:string; studentEmail:string; studentPhone:string|null; studentAccountNumber:string|null; paymentCode:string; paidAmount:number; totalAmount:number; paymentType:"FULL"|"HALF"; paymentStatus:string; pointAwarded:boolean; pointCount:number; createdAt:string };

type ConsultantStudent = {
  id: string; firstName: string; lastName: string; email: string; phone: string; dateOfBirth: string;
  province: string; district: string; city: string; side: "LEFT" | "RIGHT"; status: string;
  payId: string; payIdExpiresAt: string; courseTitle: string; paymentCode: string | null;
  paidAmount: number | null; totalAmount: number | null; accountNumber: string | null; accountStatus: string | null; createdAt: string;
};

function ConsultantMyStudentsWorkspace() {
  const [students, setStudents] = useState<ConsultantStudent[]>([]);
  const [query, setQuery] = useState("");
  const [status, setStatus] = useState("ALL");
  const [selected, setSelected] = useState<ConsultantStudent | null>(null);
  const [error, setError] = useState("");
  useEffect(() => { fetch("/api/consultant/student-registrations").then(async (response) => {
    const body = await response.json(); if (!response.ok) throw new Error(body.message ?? "Students load failed"); return body;
  }).then((body) => setStudents(body.registrations)).catch((reason) => setError(reason instanceof Error ? reason.message : "Students load failed")); }, []);
  const normalized = query.trim().toLowerCase();
  const visible = students.filter((student) => (status === "ALL" || student.status === status) && (!normalized || [student.accountNumber, student.payId, student.paymentCode, student.firstName, student.lastName, student.email, student.phone].some((value) => value?.toLowerCase().includes(normalized))));
  const statusLabel = (value: string) => ({ AWAITING_PAYMENT: "Awaiting Payment", PAYMENT_SUBMITTED: "Payment Submitted", PAYMENT_REVIEW: "Payment Review", ACTIVE: "Active", REJECTED: "Rejected" }[value] ?? value.replaceAll("_", " "));
  const statusClass = (value: string) => value === "ACTIVE" ? "success" : value === "REJECTED" ? "danger" : "warning";
  return <section className="dash-card workspace-card my-students-workspace">
    <div className="workspace-heading"><div><span className="eyebrow">REAL STUDENT DIRECTORY</span><h2>My Students</h2><p>ඔබ register කළ students, payments, SR accounts සහ access status.</p></div><span className="student-total-badge">{students.length} students</span></div>
    <div className="student-directory-tools"><input value={query} onChange={(event) => setQuery(event.target.value)} placeholder="Search: SR number, Pay ID, name, email or phone" /><select value={status} onChange={(event) => setStatus(event.target.value)}><option value="ALL">All statuses</option><option value="AWAITING_PAYMENT">Awaiting payment</option><option value="PAYMENT_REVIEW">Payment review</option><option value="ACTIVE">Active</option><option value="REJECTED">Rejected</option></select></div>
    {error && <p className="form-error">{error}</p>}
    <div className="student-directory-table"><div className="student-directory-head"><span>STUDENT</span><span>ACCOUNT / PAY ID</span><span>PLACEMENT</span><span>STATUS</span><span>DETAILS</span></div>
      {visible.map((student) => <div className="student-directory-row" key={student.id}><div><strong>{student.firstName} {student.lastName}</strong><small>{student.email}<br />{student.phone}</small></div><div><strong>{student.accountNumber ?? "SR pending"}</strong><small>{student.payId}<br />{student.courseTitle}</small></div><div><span className={`side-badge ${student.side.toLowerCase()}`}>{student.side}</span><small>{student.city}, {student.district}</small></div><div><span className={`status-badge ${statusClass(student.status)}`}>{statusLabel(student.status)}</span></div><button type="button" className="icon-detail-button" onClick={() => setSelected(student)} aria-label={`View ${student.firstName} details`}><Eye /></button></div>)}
      {!visible.length && <p className="service-account-empty">ගැළපෙන student record එකක් හමු නොවීය.</p>}
    </div>
    {selected && <div className="service-flush-overlay" onClick={() => setSelected(null)}><div className="service-flush-modal student-detail-modal" onClick={(event) => event.stopPropagation()}><button type="button" className="modal-close" onClick={() => setSelected(null)}><X /></button><span className="eyebrow">STUDENT PROFILE</span><h3>{selected.firstName} {selected.lastName}</h3><span className={`status-badge ${statusClass(selected.status)}`}>{statusLabel(selected.status)}</span><div className="student-detail-grid"><p><small>SR Account</small><strong>{selected.accountNumber ?? "Pending"}</strong></p><p><small>Pay ID</small><strong>{selected.payId}</strong></p><p><small>Email</small><strong>{selected.email}</strong></p><p><small>Phone</small><strong>{selected.phone}</strong></p><p><small>Course</small><strong>{selected.courseTitle}</strong></p><p><small>Placement</small><strong>{selected.side}</strong></p><p><small>Payment</small><strong>{selected.paidAmount === null ? "Not submitted" : `Rs. ${selected.paidAmount.toLocaleString()} / ${selected.totalAmount?.toLocaleString()}`}</strong></p><p><small>Registered</small><strong>{new Date(selected.createdAt).toLocaleDateString("en-LK")}</strong></p></div></div></div>}
  </section>;
}

function ConsultantServiceAccountsWorkspace() {
  const [accounts, setAccounts] = useState<ServiceAccount[]>([]);
  const [activity, setActivity] = useState<ServiceAccountActivity[]>([]);
  const [query, setQuery] = useState("");
  const [selected, setSelected] = useState<ServiceAccount | null>(null);
  const [detailSide, setDetailSide] = useState<"LEFT" | "RIGHT" | null>(null);
  const [error, setError] = useState("");
  useEffect(() => { fetch("/api/consultant/service-accounts").then(async (response) => {
    const body = await response.json(); if (!response.ok) throw new Error(body.message ?? "Service accounts load failed"); return body;
  }).then((body) => { setAccounts(body.accounts); setActivity(body.activity ?? []); }).catch((reason) => setError(reason instanceof Error ? reason.message : "Service accounts load failed")); }, []);
  const normalized = query.trim().toLowerCase();
  const visible = accounts.filter((account) => !normalized || account.number.toLowerCase().includes(normalized) || account.username.toLowerCase().includes(normalized));
  const visibleIds = new Set(visible.map((account) => account.id));
  const sideActivity = detailSide ? activity.filter((item) => item.side === detailSide && item.beneficiaryAccountIds.some((id) => visibleIds.has(id))) : [];
  const date = (value: string) => new Date(value).toLocaleDateString("en-LK", { year: "numeric", month: "short", day: "numeric" });
  return <section className="dash-card workspace-card service-accounts-workspace">
    <div className="workspace-heading"><div><span className="eyebrow">CONSULTANT POINT CONTROL</span><h2>Service Accounts</h2><p>ඔබ මිලදීගත් සෑම CN account එකකම points සහ weekly flush profit පරීක්ෂා කරන්න.</p></div></div>
    <div className="service-account-search"><label>SEARCH SERVICE ACCOUNT</label><input value={query} onChange={(event) => setQuery(event.target.value)} placeholder="CN number හෝ username එක ඇතුළත් කරන්න" /></div>
    {error && <p className="form-error">{error}</p>}
    <div className="service-account-table">
      <div className="service-account-head"><span>NO.</span><span>ID</span><span>USERNAME</span><span>LEFT SIDE</span><span>RIGHT SIDE</span><span>DETAILS</span></div>
      {visible.map((account) => <div className="service-account-row" key={account.id}>
        <span data-label="NO.">{String(account.position).padStart(2, "0")}</span><strong data-label="ID">{account.number}</strong><span data-label="USERNAME">{account.username}</span>
        <span data-label="LEFT SIDE" className="point-pill">{account.leftPoints} P</span><span data-label="RIGHT SIDE" className="point-pill">{account.rightPoints} P</span>
        <button type="button" className="icon-detail-button" aria-label={`${account.number} weekly profit details`} onClick={() => setSelected(account)}><Eye /></button>
      </div>)}
      {!visible.length && <p className="service-account-empty">ගැළපෙන service account එකක් හමු නොවීය.</p>}
    </div>
    <div className="service-side-options">
      <button type="button" className={detailSide === "LEFT" ? "active left" : "left"} onClick={() => setDetailSide("LEFT")}><span>LEFT SIDE DETAIL</span><strong>{activity.filter((item) => item.side === "LEFT").length} payments</strong><small>Left branch students & consultant network</small><ChevronRight /></button>
      <button type="button" className={detailSide === "RIGHT" ? "active right" : "right"} onClick={() => setDetailSide("RIGHT")}><span>RIGHT SIDE DETAIL</span><strong>{activity.filter((item) => item.side === "RIGHT").length} payments</strong><small>Right branch students & consultant network</small><ChevronRight /></button>
    </div>
    {detailSide && <div className="side-activity-panel"><div className="side-activity-title"><div><span className="eyebrow">{detailSide} BRANCH</span><h3>{detailSide} Side Details</h3><p>Search කළ service accounts වලට පහළින් පැමිණි payment සහ point records.</p></div><button type="button" onClick={() => setDetailSide(null)}><X /></button></div><div className="side-activity-list">
      {sideActivity.map((item) => <article key={item.id} className={`side-payment-record ${item.paymentType.toLowerCase()}`}><div className="side-payment-person"><span>{item.studentName.slice(0,2).toUpperCase()}</span><p><strong>{item.studentName}</strong><small>{item.studentAccountNumber ?? "SR pending"} • {item.studentEmail}<br />{item.studentPhone ?? "No phone"}</small></p></div><div><small>POINT ROUTE</small><strong>{item.beneficiaryAccountNumbers.join(" → ")}</strong><span className={`side-badge ${item.side.toLowerCase()}`}>{item.side}</span></div><div><small>PAYMENT</small><strong>Rs. {item.paidAmount.toLocaleString()}</strong><span className={`payment-type-badge ${item.paymentType.toLowerCase()}`}>{item.paymentType} PAYMENT</span></div><div><small>POINT STATUS</small><strong>+1 P × {item.beneficiaryAccountNumbers.length} ACCOUNTS</strong><span>{new Date(item.createdAt).toLocaleDateString("en-LK")}</span></div></article>)}
      {!sideActivity.length && <p className="service-account-empty">මෙම side එකට payment records තවම නැහැ.</p>}
    </div></div>}
    {selected && <div className="service-flush-overlay" onClick={() => setSelected(null)}><div className="service-flush-modal" onClick={(event) => event.stopPropagation()}>
      <button type="button" className="modal-close" onClick={() => setSelected(null)}><X /></button><span className="eyebrow">WEEKLY FLUSH PROFIT</span><h3>{selected.number}</h3><p>{selected.username}ගේ service account breakdown එක</p>
      {selected.weeklyFlush ? <><div className="flush-period"><span>{date(selected.weeklyFlush.periodStart)}</span><ArrowRight /><span>{date(selected.weeklyFlush.periodEnd)}</span></div>
        <div className="flush-stats"><div><small>Stage</small><strong>{selected.weeklyFlush.stage}</strong></div><div><small>Matched pairs</small><strong>{selected.weeklyFlush.matchedPairs}</strong></div><div><small>Left flushed</small><strong>{selected.weeklyFlush.leftFlushed} P</strong></div><div><small>Right flushed</small><strong>{selected.weeklyFlush.rightFlushed} P</strong></div></div>
        <div className="flush-profit"><span>This week profit</span><strong>Rs. {selected.weeklyFlush.amount.toLocaleString()}</strong></div></> : <div className="flush-no-data"><strong>No completed flush this week</strong><p>Commission cycle calculate කළ පසු මෙහි profit breakdown එක පෙන්වයි.</p></div>}
    </div></div>}
  </section>;
}

type AdminOverviewData = {
  students: number;
  consultants: number;
  pendingPayments: number;
  pendingApplications: number;
  activeAccounts: number;
  commissionCycleCount: number;
};

type AdminPaymentView = StudentPaymentView & {
  userId: string; createdAt: string; accountNumber?: string | null;
  student?: { name: string; email: string; phone: string | null } | null;
  placementConsultant?: {
    id: string; name: string; email: string; phone: string | null;
    accountNumber: string; side: "LEFT" | "RIGHT" | null;
  } | null;
};

type AdminBalancePaymentView = {
  id: string; amount: string; status: string; transactionReference: string; hasProof: boolean; reviewNote?: string | null;
  student: { name: string; email: string; phone: string | null };
  course: { id: string; title: string }; originalPaymentCode: string; createdAt: string;
};

function AdminDashboard({ onOpen }: { onOpen: (module: string) => void }) {
  const [overview, setOverview] = useState<AdminOverviewData | null>(null);
  const [payments, setPayments] = useState<AdminPaymentView[]>([]);
  useEffect(() => {
    Promise.all([fetch("/api/admin/overview"), fetch("/api/admin/payments")])
      .then(async ([overviewResponse, paymentResponse]) => {
        if (!overviewResponse.ok || !paymentResponse.ok) throw new Error("Admin data failed");
        setOverview(await overviewResponse.json() as AdminOverviewData);
        const data = await paymentResponse.json() as { payments: AdminPaymentView[] };
        setPayments(data.payments);
      }).catch(() => undefined);
  }, []);
  if (!overview) return <section className="dash-card"><h3>Admin data loading...</h3></section>;
  return (
    <>
      <div className="metrics-grid">
        <MetricCard label="Total Students" value={String(overview.students)} note="Click to view & search" icon={<Users />} onClick={() => onOpen("Students")} />
        <MetricCard label="Pending Payments" value={String(overview.pendingPayments)} note="Click to verify" icon={<CreditCard />} onClick={() => onOpen("Payments")} />
        <MetricCard label="Consultants" value={String(overview.consultants)} note="Click to view & search" icon={<Network />} onClick={() => onOpen("Consultants")} />
        <MetricCard label="Active Accounts" value={String(overview.activeAccounts)} note="Click to search SR/CN" icon={<UserCheck />} onClick={() => onOpen("Network")} />
      </div>
      <div className="dashboard-grid">
        <section className="dash-card">
          <div className="dash-card-heading"><div><span className="eyebrow">REAL-TIME DATA</span><h3>Latest payments</h3></div></div>
          <div className="payment-table">
            <div className="table-head"><span>Payment ID</span><span>Method</span><span>Amount</span><span>Status</span></div>
            {payments.slice(0, 5).map((item) => (
              <div className="table-row" key={item.id}>
                <span>{item.paymentCode}</span><span>{item.method.replaceAll("_", " ")}</span>
                <strong>Rs. {Number(item.paidAmount).toLocaleString()}</strong><span className="status-badge">{item.status.replaceAll("_", " ")}</span>
              </div>
            ))}
            {!payments.length && <p>No payment requests yet.</p>}
          </div>
        </section>
        <section className="dash-card">
          <div className="dash-card-heading"><h3>Platform status</h3></div>
          <div className="activity-list">
            <div><span className="activity-dot completed"><Check /></span><p><strong>{overview.activeAccounts} active accounts</strong><small>Database verified</small></p></div>
            <div><span className="activity-dot"><CircleDollarSign /></span><p><strong>{overview.commissionCycleCount} commission cycles</strong><small>Recorded cycles</small></p></div>
          </div>
        </section>
      </div>
    </>
  );
}

function OperationsDashboard({ role }: { role: "staff" | "admin" }) {
  const isAdmin = role === "admin";
  return (
    <>
      <div className="metrics-grid">
        <MetricCard
          label="Total Students"
          value="1,248"
          note="+64 this month"
          icon={<Users />}
        />
        <MetricCard
          label="Pending Payments"
          value="18"
          note="Needs review"
          icon={<CreditCard />}
        />
        <MetricCard
          label={isAdmin ? "Active Consultants" : "Open Tickets"}
          value={isAdmin ? "126" : "12"}
          note={isAdmin ? "+8 this month" : "4 high priority"}
          icon={isAdmin ? <Network /> : <Bell />}
        />
        <MetricCard
          label="Course Completion"
          value="72%"
          note="Across all students"
          icon={<GraduationCap />}
        />
      </div>
      <div className="dashboard-grid">
        <section className="dash-card">
          <div className="dash-card-heading">
            <div>
              <span className="eyebrow">ACTION REQUIRED</span>
              <h3>Payment verification</h3>
            </div>
            <button type="button">View queue</button>
          </div>
          <div className="payment-table">
            <div className="table-head">
              <span>Student</span>
              <span>Method</span>
              <span>Amount</span>
              <span>Status</span>
            </div>
            {[
              ["Sahan Jay", "Bank", "Rs. 50,000", "Review"],
              ["Ishara M.", "USDT", "154 USDT", "Review"],
              ["Dulani K.", "Bank", "Rs. 25,000", "Partial"]
            ].map((row) => (
              <div className="table-row" key={row[0]}>
                <span>{row[0]}</span>
                <span>{row[1]}</span>
                <strong>{row[2]}</strong>
                <span
                  className={
                    row[3] === "Partial"
                      ? "status-badge warning"
                      : "status-badge"
                  }
                >
                  {row[3]}
                </span>
              </div>
            ))}
          </div>
        </section>
        <section className="dash-card">
          <div className="dash-card-heading">
            <h3>{isAdmin ? "Friday commission cycle" : "Student activity"}</h3>
            <button type="button">Details</button>
          </div>
          {isAdmin ? (
            <div className="cycle-card">
              <span className="cycle-icon">
                <CircleDollarSign />
              </span>
              <strong>2026-W29</strong>
              <p>126 accounts ready for calculation</p>
              <div className="cycle-progress">
                <span>
                  <small>Estimated payout</small>
                  <strong>Rs. 684,500</strong>
                </span>
                <span className="status-badge success">Scheduled</span>
              </div>
              <button type="button" className="button button-primary full">
                Review cycle
              </button>
            </div>
          ) : (
            <div className="activity-list">
              <div>
                <span className="activity-dot completed">
                  <Check />
                </span>
                <p>
                  <strong>32 lessons completed</strong>
                  <small>Today across all students</small>
                </p>
              </div>
              <div>
                <span className="activity-dot">
                  <Users />
                </span>
                <p>
                  <strong>8 new registrations</strong>
                  <small>Waiting for payments</small>
                </p>
              </div>
            </div>
          )}
        </section>
      </div>
    </>
  );
}

