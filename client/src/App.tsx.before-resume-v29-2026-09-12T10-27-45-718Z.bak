function LegacyTradingHomePage() {
  const [overview, setOverview] =
    useState<PlatformOverview>(defaultOverview);
  const [courseDetail, setCourseDetail] = useState<PublicCourseDetail | null>(null);
  const [publicCourses, setPublicCourses] = useState<PublicCourseCard[]>([]);

  useEffect(() => {
    fetch("/api/public/overview")
      .then((response) => response.json())
      .then(setOverview)
      .catch(() => undefined);
    fetch("/api/courses/crypto-trading-zero-to-pro-sinhala")
      .then((response) => response.ok ? response.json() : null)
      .then((data) => setCourseDetail(data as PublicCourseDetail | null))
      .catch(() => undefined);
    fetch("/api/courses").then((response) => response.ok ? response.json() : { courses: [] })
      .then((data: { courses?: PublicCourseCard[] }) => setPublicCourses(data.courses ?? []))
      .catch(() => undefined);
  }, []);

  return (
    <div className="site">
      <PublicHeader />
      <main>
        <section className="hero">
          <div className="hero-grid" />
          <div className="hero-orb hero-orb-one" />
          <div className="hero-orb hero-orb-two" />
          <div className="section-shell hero-layout">
            <div className="hero-copy">
              <span className="pill">
                <Sparkles size={15} />
                SRI LANKA'S SINHALA CRYPTO LEARNING PLATFORM
              </span>
              <h1>
                Trade කරන්න කලින්
                <span>හරියට ඉගෙනගන්න.</span>
              </h1>
              <p>
                Crypto Trading ගැන කිසිම දැනුමක් නැති තැනින්, disciplined
                trader කෙනෙක් දක්වා යන සම්පූර්ණ learning path එක සරල
                සිංහලෙන්.
              </p>
              <div className="hero-actions">
                <Link to="/login" className="button button-primary">
                  Admission Form
                  <ArrowRight size={18} />
                </Link>
                <Link to="/cco-main" className="button button-ghost">
                  <UserCheck size={17} />
                  CCO Main Account
                </Link>
                <a className="button button-ghost" href="#course">
                  <BookOpen size={17} />
                  Course Details
                </a>
              </div>
              <div className="trust-row">
                <span>
                  <Check size={15} /> Sinhala-first learning
                </span>
                <span>
                  <Check size={15} /> {overview.course.language}
                </span>
                <span>
                  <Check size={15} /> {overview.course.access}
                </span>
              </div>
            </div>
            <HeroCourseCard detail={courseDetail} />
          </div>
        </section>

        <section className="proof-strip">
          <div className="section-shell proof-grid">
            <div>
              <strong>Zero → Pro</strong>
              <span>Structured learning path</span>
            </div>
            <div>
              <strong>Secure</strong>
              <span>Paid student access</span>
            </div>
            <div>
              <strong>24/7</strong>
              <span>Student dashboard access</span>
            </div>
            <div>
              <strong>100%</strong>
              <span>Sinhala explanations</span>
            </div>
          </div>
        </section>

        <section className="section public-course-catalog" id="available-courses">
          <div className="section-shell">
            <div className="section-heading">
              <span className="eyebrow">ADIL ACADEMY COURSES</span>
              <h2>ඔබට ගැළපෙන පාඨමාලාව තෝරන්න.</h2>
              <p>Admin panel එකෙන් publish කරන සියලුම පාඨමාලා මෙහි පෙන්වයි.</p>
            </div>
            <div className="public-course-grid">
              {publicCourses.map((item) => <article className="public-course-card" key={item.id}>
                <div className="public-course-cover">{item.thumbnailUrl ? <img src={courseThumbnailSrc(item)} alt={`${item.title} course cover`} /> : <BookOpen size={38} />}</div>
                <div className="public-course-body"><span className="eyebrow">ONLINE COURSE</span><h3>{item.title}</h3><p>{item.shortDescription}</p><div><strong>{item.currency} {Number(item.price).toLocaleString()}</strong><Link to="/login" className="button button-primary">Apply now <ArrowRight size={16} /></Link></div></div>
              </article>)}
              {!publicCourses.length && <p className="catalog-empty">Published courses loading...</p>}
            </div>
          </div>
        </section>

        <section className="section course-section" id="course">
          <div className="section-shell">
            <div className="section-heading">
              <span className="eyebrow">COMPLETE LEARNING PATH</span>
              <h2>අනුමාන නොකර, පිළිවෙළට ඉගෙනගන්න.</h2>
              <p>
                Beginner knowledge සිට professional risk discipline දක්වා,
                අවශ්‍ය සෑම කොටසක්ම එක learning system එකකින්.
              </p>
            </div>
            <div className="module-grid">
              {courseModules.map((module) => (
                <article className="module-card" key={module.number}>
                  <span className="module-number">{module.number}</span>
                  <div className="module-icon">
                    {module.number === "01" && <GraduationCap />}
                    {module.number === "02" && <BarChart3 />}
                    {module.number === "03" && <TrendingUp />}
                    {module.number === "04" && <ShieldCheck />}
                    {module.number === "05" && <CircleDollarSign />}
                    {module.number === "06" && <Sparkles />}
                  </div>
                  <h3>{module.title}</h3>
                  <p>{module.text}</p>
                  <span className="card-link">
                    Module details <ChevronRight size={16} />
                  </span>
                </article>
              ))}
            </div>
          </div>
        </section>

        <section className="section platform-section" id="platform">
          <div className="section-shell platform-layout">
            <div className="platform-copy">
              <span className="eyebrow">MORE THAN A VIDEO COURSE</span>
              <h2>ඔබේ සම්පූර්ණ learning journey එක එකම dashboard එකක.</h2>
              <p>
                Lessons බලන්න, progress track කරන්න, payments සහ certificates
                manage කරන්න—mobile හෝ desktop ඕනෑම device එකකින්.
              </p>
              <div className="feature-list">
                {[
                  "Secure student-only video lessons",
                  "Lesson progress සහ quiz tracking",
                  "Bank Transfer / Binance Pay verification",
                  "Completion certificates සහ notifications"
                ].map((feature) => (
                  <div key={feature}>
                    <span>
                      <Check size={16} />
                    </span>
                    {feature}
                  </div>
                ))}
              </div>
              <Link to="/login" className="text-link">
                Dashboard preview බලන්න <ArrowRight size={17} />
              </Link>
            </div>
            <div className="platform-panel">
              <div className="panel-sidebar">
                <Logo />
                <span className="active-line">
                  <LayoutDashboard size={17} /> Overview
                </span>
                <span>
                  <BookOpen size={17} /> My Course
                </span>
                <span>
                  <Award size={17} /> Certificates
                </span>
                <span>
                  <CreditCard size={17} /> Payments
                </span>
              </div>
              <div className="panel-main">
                <span className="mini-label">WEEKLY ACTIVITY</span>
                <div className="chart-bars">
                  {[34, 58, 43, 76, 61, 88, 72].map((height, index) => (
                    <span key={index} style={{ height: height + "%" }} />
                  ))}
                </div>
                <div className="panel-course-row">
                  <span className="course-play">
                    <Play size={16} fill="currentColor" />
                  </span>
                  <div>
                    <strong>Risk Management Formula</strong>
                    <span>Module 04 • Lesson 03</span>
                  </div>
                  <span className="course-time">18 min</span>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section className="section cta-section">
          <div className="section-shell">
            <div className="cta-card">
              <div>
                <span className="eyebrow">START WITH KNOWLEDGE</span>
                <h2>ඔබේ Crypto learning journey එක අදම ආරම්භ කරන්න.</h2>
                <p>
                  Learn with structure. Trade with discipline. Protect your
                  capital.
                </p>
              </div>
              <Link to="/login" className="button button-light">
                Student Dashboard
                <ArrowRight size={18} />
              </Link>
            </div>
          </div>
        </section>
      </main>
      <footer className="site-footer">
        <div className="section-shell footer-grid">
          <div>
            <Logo />
            <p>
              සිංහලෙන් Crypto Trading ඉගෙනගන්න විශ්වාසදායක learning platform
              එක.
            </p>
          </div>
          <div>
            <strong>Platform</strong>
            <a href="#course">Course</a>
            <Link to="/login">Student Login</Link>
          </div>
          <div>
            <strong>Support</strong>
            <a href="#platform">How it works</a>
            <a href="#course">FAQ</a>
            <a href="mailto:support@adilacademy.com">Contact</a>
          </div>
          <div>
            <strong>Legal</strong>
            <span>Terms & Conditions</span>
            <span>Privacy Policy</span>
            <span>Risk Disclosure</span>
          </div>
        </div>
        <div className="section-shell footer-bottom">
          <span>© 2026 Adil Academy. All rights reserved.</span>
          <span>Education only. Trading profits are not guaranteed.</span>
        </div>
      </footer>
    </div>
  );
}

function formatCoursePrice(course: PublicCourseCard) {
  const amount = Number(course.price);
  if (!Number.isFinite(amount) || amount <= 0) return "Contact for pricing";
  return `${course.currency || "LKR"} ${amount.toLocaleString("en-LK")}`;
}

function AcademyPublicHeader() {
  const [menuOpen, setMenuOpen] = useState(false);

  return (
    <header className="academy-public-header">
      <div className="section-shell academy-nav">
        <Link to="/" className="academy-brand" aria-label="Adil Academy home">
          <Logo />
        </Link>
        <button
          type="button"
          className="academy-menu-button"
          aria-label="Open navigation"
          aria-expanded={menuOpen}
          onClick={() => setMenuOpen((value) => !value)}
        >
          {menuOpen ? <X size={22} /> : <Menu size={22} />}
        </button>
        <nav className={menuOpen ? "academy-nav-links is-open" : "academy-nav-links"}>
          <a href="#available-courses" onClick={() => setMenuOpen(false)}>Courses</a>
          <a href="#why-adil" onClick={() => setMenuOpen(false)}>Why Adil</a>
          <a href="#how-it-works" onClick={() => setMenuOpen(false)}>How it works</a>
          <a href="#academy-faq" onClick={() => setMenuOpen(false)}>FAQ</a>
          <Link to="/login" onClick={() => setMenuOpen(false)}>Login</Link>
          <a className="button button-primary academy-nav-cta" href="#available-courses" onClick={() => setMenuOpen(false)}>
            Explore courses <ArrowRight size={17} />
          </a>
        </nav>
      </div>
    </header>
  );
}

function HomePage() {
  const [publicCourses, setPublicCourses] = useState<PublicCourseCard[]>([]);
  const [courseQuery, setCourseQuery] = useState("");
  const [coursesLoading, setCoursesLoading] = useState(true);
  const [selectedCourse, setSelectedCourse] = useState<PublicCourseCard | null>(null);

  useEffect(() => {
    fetch("/api/courses")
      .then((response) => response.ok ? response.json() : { courses: [] })
      .then((data: { courses?: PublicCourseCard[] }) => setPublicCourses(data.courses ?? []))
      .catch(() => setPublicCourses([]))
      .finally(() => setCoursesLoading(false));
  }, []);

  useEffect(() => {
    if (!selectedCourse) return;
    const onKeyDown = (event: KeyboardEvent) => {
      if (event.key === "Escape") setSelectedCourse(null);
    };
    document.body.classList.add("academy-modal-open");
    window.addEventListener("keydown", onKeyDown);
    return () => {
      document.body.classList.remove("academy-modal-open");
      window.removeEventListener("keydown", onKeyDown);
    };
  }, [selectedCourse]);

  const normalizedQuery = courseQuery.trim().toLowerCase();
  const filteredCourses = publicCourses.filter((course) =>
    `${course.title} ${course.shortDescription}`.toLowerCase().includes(normalizedQuery)
  );
  const featuredCourses = publicCourses.slice(0, 3);

  return (
    <div className="academy-home">
      <AcademyPublicHeader />
      <main>
        <section className="academy-hero">
          <div className="academy-hero-glow academy-hero-glow-one" />
          <div className="academy-hero-glow academy-hero-glow-two" />
          <div className="section-shell academy-hero-shell">
            <div className="academy-hero-copy">
              <span className="academy-kicker">
                <Sparkles size={16} />
                LEARN • GROW • ACHIEVE
              </span>
              <h1 className="academy-hero-title">
                <span>Learn Today.</span>
                <span className="academy-hero-title-accent">Grow Every Day.</span>
                <span>Build Your Future.</span>
              </h1>
              <p>
                ඔබේ ඉලක්කයට ගැළපෙන පාඨමාලා සහ නිවැරදි මඟපෙන්වීම සමඟ
                සාර්ථක අනාගතයක් ගොඩනඟන්න.
              </p>
              <div className="academy-hero-actions">
                <a className="button button-primary" href="#available-courses">
                  පාඨමාලා බලන්න <ArrowRight size={18} />
                </a>
                <Link className="button button-secondary" to="/login">
                  <GraduationCap size={18} /> Student portal
                </Link>
              </div>
              <div className="academy-trust-row" aria-label="Platform benefits">
                <span><Check size={16} /> Structured learning</span>
                <span><ShieldCheck size={16} /> Secure access</span>
                <span><TrendingUp size={16} /> Progress tracking</span>
              </div>
            </div>

            <div className="academy-hub-card">
              <div className="academy-hub-orbit academy-hub-orbit-one" />
              <div className="academy-hub-orbit academy-hub-orbit-two" />
              <div className="academy-hub-header">
                <div>
                  <span>ADIL ACADEMY</span>
                  <h2>Explore Our Courses</h2>
                </div>
                <div className="academy-hub-icon"><BookOpen size={24} /></div>
              </div>
              <div className="academy-hub-list">
              {publicCourses.length ? (
                publicCourses.map((course, index) => (
                  <button
                    type="button"
                    className="academy-hub-course"
                    key={course.id}
                    onClick={() => setSelectedCourse(course)}
                  >
                    <span className="academy-hub-number">
                      {String(index + 1).padStart(2, "0")}
                    </span>

                    <span className="academy-hub-course-copy">
                      <strong>{course.title}</strong>
                      <small>
                        {course.currency} {Number(course.price).toLocaleString()}
                      </small>
                    </span>

                    <ArrowRight size={18} />
                  </button>
                ))
              ) : (
                <div className="academy-hub-empty">
                  <strong>No courses available yet.</strong>
                </div>
              )}
            </div>

            <div className="academy-hub-footer">
                <span><span className="academy-live-dot" /> Learning platform online</span>
                {publicCourses.length > 0 && <strong>{publicCourses.length} course{publicCourses.length === 1 ? "" : "s"}</strong>}
              </div>
            </div>
          </div>
        </section>

        <section className="academy-section academy-courses-section" id="available-courses">
          <div className="section-shell academy-section-shell">
            <div className="academy-section-heading">
              <div>
                <span className="academy-eyebrow">COURSE CATALOG</span>
                <h2>ඔබට ගැළපෙන පාඨමාලාව සොයාගන්න</h2>
                <p>Admin විසින් publish කරන සියලු පාඨමාලා මෙහි ස්වයංක්‍රීයව පෙන්වයි.</p>
              </div>
              <label className="academy-course-search">
                <Search size={20} />
                <input
                  value={courseQuery}
                  onChange={(event) => setCourseQuery(event.target.value)}
                  placeholder="Course name හෝ subject එක search කරන්න"
                  aria-label="Search courses"
                />
              </label>
            </div>

            {coursesLoading ? (
              <div className="academy-empty-state">
                <BookOpen size={28} />
                <h3>Course catalog loading...</h3>
              </div>
            ) : filteredCourses.length ? (
              <div className="academy-course-grid">
                {filteredCourses.map((course) => (
                  <article className="academy-course-card" key={course.id}>
                    <div className="academy-course-image">
                      {course.thumbnailUrl ? (
                        <img src={courseThumbnailSrc(course)} alt="" />
                      ) : (
                        <div className="academy-course-placeholder"><GraduationCap size={42} /></div>
                      )}
                      <span>Adil Academy course</span>
                    </div>
                    <div className="academy-course-body">
                      <div className="academy-course-title-row">
                        <h3>{course.title}</h3>
                        <span className="academy-course-icon"><BookOpen size={18} /></span>
                      </div>
                      <p>{course.shortDescription || "A structured Adil Academy learning experience."}</p>
                      <div className="academy-course-meta">
                        <span>Course fee</span>
                        <strong>{formatCoursePrice(course)}</strong>
                      </div>
                      <div className="academy-course-actions">
                        <button type="button" className="button button-secondary" onClick={() => setSelectedCourse(course)}>
                          Course details
                        </button>
                        <Link className="button button-primary" to="/login">
                          Apply now <ArrowRight size={17} />
                        </Link>
                      </div>
                    </div>
                  </article>
                ))}
              </div>
            ) : (
              <div className="academy-empty-state">
                <Search size={28} />
                <h3>{publicCourses.length ? "Matching course එකක් හමු නොවීය." : "Published courses තවම නැහැ."}</h3>
                <p>{publicCourses.length ? "වෙනත් course name එකක් search කරන්න." : "Admin panel එකෙන් publish කළ පසු courses මෙහි පෙන්වයි."}</p>
              </div>
            )}
          </div>
        </section>

        <section className="academy-section academy-benefits-section" id="why-adil">
          <div className="section-shell academy-section-shell">
            <div className="academy-section-heading academy-section-heading-centered">
              <div>
                <span className="academy-eyebrow">WHY ADIL ACADEMY</span>
                <h2>ඉගෙනීම පැහැදිලි, ආරක්ෂිත සහ ඉලක්කගත කරමු</h2>
                <p>Course එකක් මිලදී ගැනීමේ සිට completion දක්වා එකම professional experience එකක්.</p>
              </div>
            </div>
            <div className="academy-benefits-grid">
              <article className="academy-benefit-card">
                <div><Target size={23} /></div>
                <span>01</span>
                <h3>Goal-focused learning</h3>
                <p>සෑම පාඨමාලාවක්ම පැහැදිලි learning path එකක් සහ measurable progress එකක් සමඟ.</p>
              </article>
              <article className="academy-benefit-card">
                <div><GraduationCap size={23} /></div>
                <span>02</span>
                <h3>One student portal</h3>
                <p>Lessons, progress, payments සහ certificates එකම dashboard එකකින් manage කරන්න.</p>
              </article>
              <article className="academy-benefit-card">
                <div><ShieldCheck size={23} /></div>
                <span>03</span>
                <h3>Verified access</h3>
                <p>Payment verification සහ secure login workflow සමඟ නිවැරදි learnerට පමණක් access.</p>
              </article>
              <article className="academy-benefit-card">
                <div><Headphones size={23} /></div>
                <span>04</span>
                <h3>Learning support</h3>
                <p>Course journey එක අතරතුර අවශ්‍ය මඟපෙන්වීම සඳහා support experience එකක්.</p>
              </article>
            </div>
          </div>
        </section>

        <section className="academy-section academy-journey-section" id="how-it-works">
          <div className="section-shell academy-journey-shell">
            <div className="academy-journey-copy">
              <span className="academy-eyebrow">HOW IT WORKS</span>
              <h2>ඔබේ learning journey එක steps තුනකින් අරඹන්න</h2>
              <p>Course එක තෝරා, application එක submit කර, approval ලැබුණු පසු secure student portal එකෙන් ඉගෙනීම අරඹන්න.</p>
              <Link className="button button-primary" to="/login">
                Start your application <ArrowRight size={18} />
              </Link>
            </div>
            <div className="academy-steps">
              <article className="academy-step">
                <span>01</span>
                <div><Search size={22} /></div>
                <h3>Choose a course</h3>
                <p>ඔබේ goal එකට සහ budget එකට ගැළපෙන course එක තෝරන්න.</p>
              </article>
              <article className="academy-step">
                <span>02</span>
                <div><CreditCard size={22} /></div>
                <h3>Submit application</h3>
                <p>අවශ්‍ය details සහ payment proof එක secure form එකෙන් යවන්න.</p>
              </article>
              <article className="academy-step">
                <span>03</span>
                <div><Play size={22} /></div>
                <h3>Start learning</h3>
                <p>Approval පසු login වී lessons සහ progress එක access කරන්න.</p>
              </article>
            </div>
          </div>
        </section>

        <section className="academy-section academy-platform-section">
          <div className="section-shell academy-platform-shell">
            <div className="academy-platform-copy">
              <span className="academy-eyebrow">STUDENT EXPERIENCE</span>
              <h2>ඔබ ඉගෙනගන්න හැමදේම එක dashboard එකක</h2>
              <p>Course access, lesson progress, payments සහ certificates පැහැදිලිව manage කළ හැකි mobile-friendly learning environment එකක්.</p>
              <ul>
                <li><Check size={17} /> Personal course library</li>
                <li><Check size={17} /> Lesson-by-lesson progress</li>
                <li><Check size={17} /> Payment and access status</li>
                <li><Check size={17} /> Certificate readiness</li>
              </ul>
            </div>
            <div className="academy-platform-preview">
              <div className="academy-preview-topbar">
                <div><Logo /></div>
                <span>Student dashboard</span>
                <span className="academy-preview-avatar">ST</span>
              </div>
              <div className="academy-preview-body">
                <div className="academy-preview-sidebar">
                  <span className="is-active"><LayoutDashboard size={17} /> Overview</span>
                  <span><BookOpen size={17} /> My courses</span>
                  <span><BarChart3 size={17} /> Progress</span>
                  <span><Award size={17} /> Certificates</span>
                </div>
                <div className="academy-preview-content">
                  <span className="academy-preview-label">CONTINUE LEARNING</span>
                  <h3>Your active course</h3>
                  <p>Next lesson ready to continue</p>
                  <div className="academy-preview-progress"><span /></div>
                  <div className="academy-preview-stats">
                    <div><strong>Progress</strong><span>Tracked</span></div>
                    <div><strong>Access</strong><span>Secure</span></div>
                    <div><strong>Support</strong><span>Available</span></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section className="academy-section academy-faq-section" id="academy-faq">
          <div className="section-shell academy-faq-shell">
            <div className="academy-faq-intro">
              <span className="academy-eyebrow">FREQUENTLY ASKED QUESTIONS</span>
              <h2>ඔබට අවශ්‍ය පිළිතුරු</h2>
              <p>Enrollment කිරීමට පෙර වැදගත් මූලික තොරතුරු මෙතැනින් බලන්න.</p>
            </div>
            <div className="academy-faq-list">
              <details>
                <summary>Course එකකට apply කරන්නේ කොහොමද?<ChevronRight size={18} /></summary>
                <p>Course card එකේ Apply now හෝ Admission Form button එක භාවිත කර details සහ payment proof submit කරන්න.</p>
              </details>
              <details>
                <summary>Payment කළ විගස course access ලැබෙනවාද?<ChevronRight size={18} /></summary>
                <p>Admin payment details verify කර approval ලබාදුන් පසු secure student access activate වේ.</p>
              </details>
              <details>
                <summary>මගේ course progress බලන්නේ කොහොමද?<ChevronRight size={18} /></summary>
                <p>Login වූ පසු Student Dashboard එකෙන් lessons, progress සහ certificate status බලන්න පුළුවන්.</p>
              </details>
              <details>
                <summary>Course lessons public website එකෙන් බලන්න පුළුවන්ද?<ChevronRight size={18} /></summary>
                <p>Public page එකේ sales information පමණක් පෙන්වයි. Lessons සඳහා approved student account එකක් අවශ්‍යයි.</p>
              </details>
            </div>
          </div>
        </section>

        <section className="academy-section academy-final-cta">
          <div className="section-shell">
            <div className="academy-cta-card">
              <div>
                <span className="academy-eyebrow">YOUR NEXT STEP</span>
                <h2>අදම ඔබේ අලුත් learning journey එක අරඹන්න.</h2>
                <p>Available courses අතරින් ඔබට ගැළපෙන එක තෝරා application එක submit කරන්න.</p>
              </div>
              <div>
                <a className="button button-primary" href="#available-courses">Explore courses <ArrowRight size={18} /></a>
                <Link className="button button-secondary" to="/login">Login</Link>
              </div>
            </div>
          </div>
        </section>
      </main>

      <footer className="academy-footer">
        <div className="section-shell academy-footer-grid">
          <div className="academy-footer-brand">
            <Logo />
            <p>Professional digital learning experiences for ambitious students.</p>
          </div>
          <div>
            <strong>Explore</strong>
            <a href="#available-courses">Courses</a>
            <a href="#why-adil">Why Adil</a>
            <a href="#how-it-works">How it works</a>
          </div>
          <div>
            <strong>Access</strong>
            <Link to="/login">Student login</Link>
            <Link to="/cco-main">CCO main access</Link>
            <a href="#academy-faq">FAQ</a>
          </div>
          <div>
            <strong>Support</strong>
            <a href="#academy-faq">Help center</a>
            <a href="mailto:adilacademy65@gmail.com">adilacademy65@gmail.com</a>
          </div>
        </div>
        <div className="section-shell academy-footer-bottom">
          <span>© 2026 Adil Academy. All rights reserved.</span>
          <span>Learn with purpose. Grow with confidence.</span>
        </div>
      </footer>

      {selectedCourse && (
        <div className="academy-course-modal-backdrop" role="presentation" onMouseDown={() => setSelectedCourse(null)}>
          <section
            className="academy-course-modal"
            role="dialog"
            aria-modal="true"
            aria-labelledby="academy-course-modal-title"
            onMouseDown={(event) => event.stopPropagation()}
          >
            <button type="button" className="academy-modal-close" aria-label="Close course details" onClick={() => setSelectedCourse(null)}>
              <X size={21} />
            </button>
            <div className="academy-modal-cover">
              {selectedCourse.thumbnailUrl ? (
                <img src={courseThumbnailSrc(selectedCourse)} alt="" />
              ) : (
                <GraduationCap size={54} />
              )}
            </div>
            <div className="academy-modal-content">
              <span className="academy-eyebrow">COURSE DETAILS</span>
              <h2 id="academy-course-modal-title">{selectedCourse.title}</h2>
              <p className="academy-modal-full-description">
                {selectedCourse.description?.trim() ||
                  selectedCourse.shortDescription ||
                  "A structured Adil Academy learning experience."}
              </p>
              <div className="academy-modal-price">
                <span>Course fee</span>
                <strong>{formatCoursePrice(selectedCourse)}</strong>
              </div>
              <div className="academy-modal-note">
                <ShieldCheck size={19} />
                Lesson content is available only after payment verification and account approval.
              </div>
              <div className="academy-modal-actions">
                <Link className="button button-primary" to="/cco-main">
                  Apply for this course <ArrowRight size={18} />
                </Link>
                <button type="button" className="button button-secondary" onClick={() => setSelectedCourse(null)}>Close</button>
              </div>
            </div>
          </section>
        </div>
      )}
    </div>
  );
}

function CcoMainApplicationPage() {
  const [payId, setPayId] = useState(""); const [validated, setValidated] = useState<{name:string;email:string;phone:string;amount:number}|null>(null);
  const [message, setMessage] = useState(""); const [error, setError] = useState(""); const [busy, setBusy] = useState(false);
  async function validate(event: FormEvent<HTMLFormElement>) { event.preventDefault(); setBusy(true); setError(""); try { const response=await fetch("/api/public/cco-main/validate",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({payId})}); const data=await response.json(); if(!response.ok)throw new Error(data.message||"Pay ID invalid."); setValidated(data); } catch(e){setError(e instanceof Error?e.message:"Pay ID validate කළ නොහැක.")} finally{setBusy(false)} }
  async function submit(event: FormEvent<HTMLFormElement>) { event.preventDefault(); const form=new FormData(event.currentTarget); const slip=form.get("proof") as File; if(!slip?.size){setError("Bank slip එක තෝරන්න.");return} setBusy(true);setError("");try{const body=Object.fromEntries(Array.from(form.entries()).filter(([key])=>key!=="proof"));const response=await fetch("/api/public/cco-main/applications",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({...body,payId})});const data=await response.json();if(!response.ok)throw new Error(data.message||"Application submit failed.");const proof=await fetch(`/api/public/cco-main/applications/${data.applicationId}/proof`,{method:"PUT",headers:{"Content-Type":slip.type,"X-Registration-Token":data.registrationToken},body:slip});const result=await proof.json();if(!proof.ok)throw new Error(result.message||"Slip upload failed.");setMessage(`✓ Application submitted successfully. Reserved account: ${data.accountNumber}. Admin payment slip එක check කර නිවැරදි නම් පැය 24ක් ඇතුළත email එකට OTP code එකක් එවනු ඇත. OTP ලැබුණු පසු Login → Verify OTP වෙත ගොස් OTP සහ නව password එක ඇතුළත් කරන්න.`)}catch(e){setError(e instanceof Error?e.message:"Application submit failed.")}finally{setBusy(false)}}
  const names=validated?.name.trim().split(/\s+/)??[];
  return <div className="cco-main-public"><PublicHeader/><main className="section-shell"><div className="cco-main-intro"><span className="pill"><UserCheck/> COURSE-INDEPENDENT CONSULTING</span><h1>CCO Main Account</h1><p>Course එකකට සම්බන්ධ නොවී Adil Academy consultant කෙනෙකු වීමට Admin ලබාදුන් special Pay ID එක භාවිත කරන්න.</p></div>{message?<section className="cco-main-success"><Check/><h2>Submission successful</h2><p>{message}</p><Link className="button button-primary" to="/login">Verify OTP / Login <ArrowRight/></Link></section>:!validated?<form className="cco-main-card" onSubmit={validate}><span className="eyebrow">STEP 01</span><h2>Special Pay ID verify කරන්න</h2><label>CCO Main Pay ID<input value={payId} onChange={e=>setPayId(e.target.value.toUpperCase())} placeholder="CCO-YYYYMMDD-XXXXXXXX" required/></label>{error&&<p className="form-error">{error}</p>}<button className="button button-primary" disabled={busy}>{busy?"Checking...":"Continue"}<ArrowRight/></button></form>:<form className="cco-main-card cco-main-details" onSubmit={submit}><div><span className="eyebrow">STEP 02</span><h2>Consultant details & payment proof</h2><p><strong>{payId}</strong> · Required amount: <strong>Rs. {validated.amount.toLocaleString()}</strong></p></div><div className="cco-form-grid"><label>First name<input name="firstName" defaultValue={names[0]??""} required/></label><label>Last name<input name="lastName" defaultValue={names.slice(1).join(" ")} required/></label><label>Email<input name="email" type="email" value={validated.email} readOnly/></label><label>Phone<input name="phone" defaultValue={validated.phone} required/></label><label>Date of birth<input name="dateOfBirth" type="date" required/></label><label>NIC / Passport<input name="nicOrPassport" required/></label><label className="wide">Address line 1<input name="addressLine1" required/></label><label className="wide">Address line 2<input name="addressLine2"/></label><label>Province<input name="province" required/></label><label>District<input name="district" required/></label><label>City<input name="city" required/></label><label>Bank reference<input name="transactionReference" value={payId} readOnly/></label><label className="wide">Bank slip (JPG, PNG, WebP or PDF)<input name="proof" type="file" accept="image/jpeg,image/png,image/webp,application/pdf" required/></label></div>{error&&<p className="form-error">{error}</p>}<button className="button button-primary" disabled={busy}>{busy?"Submitting...":"Submit CCO Main application"}<ArrowRight/></button></form>}</main></div>;
}

const roleOptions: {
  role: UserRole;
  title: string;
  description: string;
  icon: ReactNode;
}[] = [
  {
    role: "student",
    title: "Student",
    description: "Course, progress සහ certificates",
    icon: <GraduationCap />
  },
  {
    role: "consultant",
    title: "Consultant",
    description: "Accounts, network සහ income",
    icon: <Network />
  },
  {
    role: "staff",
    title: "Staff",
    description: "Payments සහ students",
    icon: <UserCheck />
  },
  {
    role: "admin",
    title: "Super Admin",
    description: "Complete platform control",
    icon: <ShieldCheck />
  }
];

function LoginPage({ onLogin }: { onLogin: (user: DemoUser) => void }) {
  const navigate = useNavigate();
  const [mode, setMode] = useState<"login" | "register" | "verify">(
    "login"
  );
  const [busyRole, setBusyRole] = useState<UserRole | null>(null);
  const [submitting, setSubmitting] = useState(false);
  const [showPassword, setShowPassword] = useState(false);
  const [error, setError] = useState("");
  const [notice, setNotice] = useState("");
  const [proof, setProof] = useState<File | null>(null);
  const [courses, setCourses] = useState<{ id: string; title: string; price: string; currency: string }[]>([]);
  const [form, setForm] = useState({
    displayName: "",
    email: "",
    phone: "",
    password: "",
    nicOrPassport: "",
    address: "",
    dateOfBirth: "",
    courseId: "",
    method: "BANK_TRANSFER",
    paidAmount: "",
    transactionReference: "",
    payId: "",
    otp: ""
  });

  useEffect(() => {
    fetch("/api/courses").then((response) => response.json()).then((data: { courses?: typeof courses }) => {
      const items = data.courses ?? [];
      setCourses(items);
    }).catch(() => setCourses([]));
  }, []);

  async function enterDemo(role: UserRole) {
    setBusyRole(role);
    setError("");
    try {
      const response = await fetch("/api/auth/demo-login", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ role })
      });
      if (!response.ok) throw new Error("Preview login failed.");
      const data = (await response.json()) as { user: DemoUser };
      onLogin(data.user);
      navigate("/dashboard");
    } catch {
      setError("Preview එක විවෘත කළ නොහැක. Server එක නැවත run කරන්න.");
    } finally {
      setBusyRole(null);
    }
  }

  async function submitAccount(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    setSubmitting(true);
    setError("");
    try {
      if (mode === "register") {
        if (!proof) throw new Error("Payment slip එක තෝරන්න.");
        const response = await fetch("/api/auth/apply", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            displayName: form.displayName, email: form.email, phone: form.phone,
            nicOrPassport: form.nicOrPassport, courseId: form.courseId,
            payId: form.payId,
            transactionReference: form.payId
          })
        });
        const application = await response.json() as { applicationId?: string; registrationToken?: string; paymentCode?: string; message?: string };
        if (!response.ok || !application.applicationId || !application.registrationToken) throw new Error(application.message || "Application failed.");
        const upload = await fetch(`/api/auth/applications/${application.applicationId}/proof`, {
          method: "PUT", headers: { "Content-Type": proof.type, "X-Registration-Token": application.registrationToken }, body: proof
        });
        const uploadData = await upload.json() as { message?: string; confirmationEmailSent?: boolean };
        if (!upload.ok) throw new Error(uploadData.message || "Payment proof upload failed.");
        setNotice(`Application එක සාර්ථකයි (${application.paymentCode}). ${uploadData.confirmationEmailSent ? "Confirmation email එක යවා ඇත." : "Details save වී ඇත; confirmation email එක යැවීමට නොහැකි විය."} Admin approve කළ පසු OTP එක ලැබේ.`);
        setForm((current) => ({ ...current, password: "", otp: "" }));
        setShowPassword(false);
        setMode("verify");
        return;
      }
      const response = await fetch(mode === "verify" ? "/api/auth/verify" : "/api/auth/login", {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify(mode === "verify" ? { email: form.email, code: form.otp, password: form.password } : { email: form.email, password: form.password })
      });
      const data = (await response.json()) as {
        user?: DemoUser;
        message?: string;
      };
      if (!response.ok || !data.user) {
        throw new Error(data.message || "Account request failed.");
      }
      onLogin(data.user);
      navigate("/dashboard");
    } catch (requestError) {
      setError(
        requestError instanceof Error
          ? requestError.message
          : "Account request failed."
      );
    } finally {
      setSubmitting(false);
    }
  }

  async function resendOtp() {
    setError("");
    const response = await fetch("/api/auth/resend-otp", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ email: form.email }) });
    const data = await response.json() as { message?: string };
    if (!response.ok) setError(data.message || "OTP resend failed.");
    else setNotice(data.message || "OTP sent.");
  }

  return (
    <div className="login-page">
      <div className="login-brand-panel">
        <Link to="/" className="login-back">
          <ArrowRight size={17} /> Home වෙත
        </Link>
        <Logo />
        <div className="login-brand-copy">
          <span className="pill">
            <LockKeyhole size={15} /> SECURE LEARNING PLATFORM
          </span>
          <h1>Learn. Grow. Lead.</h1>
          <p>
            Student learning සිට consultant business management දක්වා Adil
            Academy එකම digital platform එකක.
          </p>
        </div>
        <div className="login-quote">
          <ShieldCheck />
          <div>
            <strong>Protected access</strong>
            <span>Role-based dashboards සහ secure student content.</span>
          </div>
        </div>
      </div>
      <div className="login-form-panel">
        <div className="login-card">
          <div className="auth-tabs">
            {[
              ["login", "Login"],
              ["register", "Apply"],
              ["verify", "Verify OTP"]
            ].map(([value, label]) => (
              <button
                key={value}
                type="button"
                className={mode === value ? "active" : ""}
                onClick={() => {
                  setMode(value as typeof mode);
                  setForm((current) => ({ ...current, password: "", otp: "" }));
                  setShowPassword(false);
                  setError("");
                  setNotice("");
                }}
              >
                {label}
              </button>
            ))}
          </div>
          <>
              <span className="eyebrow">
                {mode === "register" ? "STUDENT ADMISSION" : mode === "verify" ? "EMAIL VERIFICATION" : "WELCOME BACK"}
              </span>
              <h2>
                {mode === "register" ? "Admission form එක" : mode === "verify" ? "OTP verify කරන්න" : "Login වෙන්න"}
              </h2>
              <p>
                {mode === "register"
                  ? "Details සහ payment proof submit කරන්න. Admin approval පසු OTP email එක ලැබේ."
                  : mode === "verify"
                    ? "Payment approve වූ පසු email එකට ලැබුණු OTP එක දමා permanent password එක සකස් කරන්න."
                  : "ඔබගේ Adil Academy account එකට secure ලෙස ඇතුළු වෙන්න."}
              </p>
              <form className="auth-form" onSubmit={submitAccount}>
                {mode === "register" && (
                  <>
                    <label className="auth-wide">
                      පාඨමාලාව / පන්තිය තෝරන්න
                      <select required value={form.courseId} onChange={(event) => setForm({ ...form, courseId: event.target.value })}>
                        <option value="">පාඨමාලාවක් තෝරන්න</option>
                        {courses.map((course) => <option key={course.id} value={course.id}>{course.title}</option>)}
                      </select>
                    </label>
                    {form.courseId && <>
                    <label>
                      සම්පූර්ණ නම
                      <input
                        required
                        minLength={2}
                        value={form.displayName}
                        onChange={(event) =>
                          setForm({ ...form, displayName: event.target.value })
                        }
                        placeholder="ඔබගේ නම"
                        autoComplete="name"
                      />
                    </label>
                    <label>
                      දුරකථන අංකය
                      <input
                        value={form.phone}
                        onChange={(event) =>
                          setForm({ ...form, phone: event.target.value })
                        }
                        placeholder="+94 7X XXX XXXX"
                        autoComplete="tel"
                      />
                    </label>
                    <label>NIC / Passport<input required value={form.nicOrPassport} onChange={(event) => setForm({ ...form, nicOrPassport: event.target.value })} placeholder="NIC හෝ Passport අංකය" /></label>
                    <label>Email<input required type="email" value={form.email} onChange={(event) => setForm({ ...form, email: event.target.value })} placeholder="name@example.com" autoComplete="email" /></label>
                    <label className="auth-wide">Pay ID / Bank Reference<input required value={form.payId} onChange={(event) => setForm({ ...form, payId: event.target.value.toUpperCase() })} placeholder="ADIL-PAY-YYYYMMDD-XXXXXX" /><small>Email එකට ලැබුණු Pay ID එක bank payment Reference ලෙසත් මෙහිත් වෙනසක් නොකර දාන්න.</small></label>
                    <label className="auth-wide">Payment slip<input required type="file" accept="image/jpeg,image/png,image/webp,application/pdf" onChange={(event) => setProof(event.target.files?.[0] ?? null)} /></label>
                    </>}
                  </>
                )}
                {mode !== "register" && <label>
                  Email
                  <input
                    required
                    type="email"
                    value={form.email}
                    onChange={(event) =>
                      setForm({ ...form, email: event.target.value })
                    }
                    placeholder="name@example.com"
                    autoComplete="email"
                  />
                </label>}
                {mode === "verify" && <label className="auth-wide">OTP code<input required inputMode="numeric" pattern="[0-9]{6}" maxLength={6} value={form.otp} onChange={(event) => setForm({ ...form, otp: event.target.value.replace(/\D/g, "") })} placeholder="6-digit OTP" /></label>}
                {mode !== "register" && <label>
                  Password
                  <span className="password-input-wrap">
                    <input
                      required
                      minLength={8}
                      type={showPassword ? "text" : "password"}
                      value={form.password}
                      onChange={(event) => setForm({ ...form, password: event.target.value })}
                      placeholder="••••••••"
                      autoComplete={mode === "verify" ? "new-password" : "current-password"}
                      data-lpignore={mode === "verify" ? "true" : undefined}
                      data-1p-ignore={mode === "verify" ? "true" : undefined}
                    />
                    <button type="button" className="password-visibility" onClick={() => setShowPassword((visible) => !visible)} aria-label={showPassword ? "Password සඟවන්න" : "Password පෙන්වන්න"} title={showPassword ? "Password සඟවන්න" : "Password පෙන්වන්න"}>
                      {showPassword ? <EyeOff size={18} /> : <Eye size={18} />}
                    </button>
                  </span>
                </label>}
                {mode === "verify" && (
                  <small className="password-hint">
                    අකුරු 8+, uppercase, lowercase සහ number එකක් අවශ්‍යයි.
                  </small>
                )}
                {mode === "verify" && <button className="otp-resend" type="button" onClick={() => void resendOtp()}>OTP එක නැවත යවන්න</button>}
                <button
                  type="submit"
                  className="button button-primary auth-submit"
                  disabled={submitting}
                >
                  {submitting
                    ? "Please wait..."
                    : mode === "register"
                      ? "Application submit කරන්න"
                      : mode === "verify" ? "Verify කර Login වෙන්න" : "Login"}
                  {!submitting && <ArrowRight size={17} />}
                </button>
              </form>
            </>
          {notice && <p className="form-success">{notice}</p>}
          {error && <p className="form-error">{error}</p>}
          <div className="login-note">
            <LockKeyhole size={15} />
            Password සහ session data secure server-side authentication එකකින්
            ආරක්ෂා වේ.
          </div>
        </div>
      </div>
    </div>
  );
}

