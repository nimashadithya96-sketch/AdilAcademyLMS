function extractVideoId(provider: string | null | undefined, rawValue: string | null | undefined) {
  const value = rawValue?.trim();
  if (!value) return "";
  const normalizedProvider = provider === "vimeo" ? "vimeo" : "youtube";
  const candidate = /^https?:\/\//i.test(value) ? value : value.includes(".") ? `https://${value}` : "";

  if (candidate) {
    try {
      const url = new URL(candidate);
      const host = url.hostname.toLowerCase().replace(/^www\./, "");
      const parts = url.pathname.split("/").filter(Boolean);
      if (normalizedProvider === "vimeo" || host.endsWith("vimeo.com")) {
        const id = [...parts].reverse().find((part) => /^\d+$/.test(part));
        if (id) return id;
      }
      if (host === "youtu.be") return parts[0] ?? "";
      if (host.endsWith("youtube.com") || host.endsWith("youtube-nocookie.com")) {
        if (url.pathname === "/watch") return url.searchParams.get("v") ?? "";
        const markerIndex = parts.findIndex((part) => ["embed", "shorts", "live"].includes(part));
        if (markerIndex >= 0) return parts[markerIndex + 1] ?? "";
      }
    } catch {
      return "";
    }
  }

  if (normalizedProvider === "vimeo") return /^\d+$/.test(value) ? value : "";
  return /^[A-Za-z0-9_-]{6,}$/.test(value) ? value : "";
}

function buildVideoEmbedUrl(provider: string | null | undefined, rawValue: string | null | undefined) {
  const id = extractVideoId(provider, rawValue);
  if (!id) return "";
  if (provider === "vimeo") {
    return `https://player.vimeo.com/video/${encodeURIComponent(id)}?controls=0&title=0&byline=0&portrait=0&dnt=1&api=1`;
  }
  const origin = typeof window === "undefined" ? "" : `&origin=${encodeURIComponent(window.location.origin)}`;
  return `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}?rel=0&controls=0&disablekb=1&fs=0&iv_load_policy=3&playsinline=1&enablejsapi=1&modestbranding=1${origin}`;
}

function ProtectedVideoPlayer({
  provider,
  rawValue,
  title,
  watermark,
  trackingEnabled = false,
  initialWatchedSeconds = 0,
  onDurationDetected,
  onWatchHeartbeat
}: {
  provider: string | null | undefined;
  rawValue: string | null | undefined;
  title: string;
  watermark?: string;
  trackingEnabled?: boolean;
  initialWatchedSeconds?: number;
  onDurationDetected?: (durationSeconds: number) => void;
  onWatchHeartbeat?: (elapsedSeconds: number, durationSeconds: number) => void;
}) {
  const frameRef = useRef<HTMLIFrameElement | null>(null);
  const shellRef = useRef<HTMLDivElement | null>(null);
  const durationRef = useRef(0);
  const playingRef = useRef(false);

  // ADIL_BACK_REPLAY_V1
  // currentTimeRef = player's current position.
  // furthestWatchedRef = furthest genuinely watched position.
  // Replaying an already watched section must not increase progress twice.
  const currentTimeRef = useRef(0);
  const furthestWatchedRef = useRef(Math.max(0, Number(initialWatchedSeconds) || 0));

  const durationCallbackRef = useRef(onDurationDetected);
  const heartbeatCallbackRef = useRef(onWatchHeartbeat);
  const trackingRef = useRef({
    lastCurrentTime: null as number | null,
    lastWallTime: 0,
    pendingSeconds: 0
  });
  const [loaded, setLoaded] = useState(false);
  const [playing, setPlaying] = useState(false);

  // ADIL_AUTO_HIDE_CONTROLS_V1
  const [controlsVisible, setControlsVisible] = useState(true);
  const controlsHideTimerRef = useRef<number | null>(null);

  const videoUrl = buildVideoEmbedUrl(provider, rawValue);

  useEffect(() => {
    durationCallbackRef.current = onDurationDetected;
  }, [onDurationDetected]);

  useEffect(() => {
    heartbeatCallbackRef.current = onWatchHeartbeat;
  }, [onWatchHeartbeat]);

  useEffect(() => {
    const saved = Math.max(0, Number(initialWatchedSeconds) || 0);
    if (saved > furthestWatchedRef.current) {
      furthestWatchedRef.current = saved;
    }
  }, [initialWatchedSeconds]);

  function postToPlayer(payload: unknown) {
    const frameWindow = frameRef.current?.contentWindow;
    if (!frameWindow) return;
    const targetOrigin = provider === "vimeo"
      ? "https://player.vimeo.com"
      : "https://www.youtube-nocookie.com";
    frameWindow.postMessage(provider === "vimeo" ? payload : JSON.stringify(payload), targetOrigin);
  }

  function sendPlayerCommand(command: "play" | "pause") {
    if (provider === "vimeo") {
      postToPlayer({ method: command });
    } else {
      postToPlayer({
        event: "command",
        func: command === "play" ? "playVideo" : "pauseVideo",
        args: []
      });
    }
  }

  function seekPlayer(targetSeconds: number) {
    const duration = durationRef.current;
    const safeTarget = Math.max(
      0,
      Math.min(
        Number.isFinite(duration) && duration > 0 ? duration : Number.MAX_SAFE_INTEGER,
        Number.isFinite(targetSeconds) ? targetSeconds : 0
      )
    );

    flushPending(true);
    currentTimeRef.current = safeTarget;
    resetPlaybackSample(safeTarget);

    if (provider === "vimeo") {
      postToPlayer({ method: "setCurrentTime", value: safeTarget });
    } else {
      postToPlayer({
        event: "command",
        func: "seekTo",
        args: [safeTarget, true]
      });
    }
  }

  function rewindTenSeconds() {
    showControls();
    seekPlayer(Math.max(0, currentTimeRef.current - 10));
  }

  function restartVideo() {
    showControls();
    seekPlayer(0);
  }

  function reportDuration(durationSeconds: number) {
    const normalized = Math.round(durationSeconds);
    if (!Number.isFinite(normalized) || normalized < 10 || normalized > 86400) return;
    if (durationRef.current === normalized) return;
    durationRef.current = normalized;
    durationCallbackRef.current?.(normalized);
  }

  function flushPending(force = false) {
    const durationSeconds = durationRef.current;
    if (!trackingEnabled || durationSeconds <= 0) return;
    const pending = trackingRef.current.pendingSeconds;
    if ((!force && pending < 5) || (force && pending < 0.75)) return;
    const elapsedSeconds = Math.max(1, Math.min(15, Math.floor(force ? pending + 0.25 : 5)));
    trackingRef.current.pendingSeconds = Math.max(0, pending - elapsedSeconds);
    heartbeatCallbackRef.current?.(elapsedSeconds, durationSeconds);
  }

  function resetPlaybackSample(currentTime: number | null = null) {
    trackingRef.current.lastCurrentTime = currentTime;
    trackingRef.current.lastWallTime = performance.now();
  }

  function processPlaybackSample(
    currentTime: number,
    durationSeconds: number,
    isActuallyPlaying: boolean,
    ended = false
  ) {
    if (!Number.isFinite(currentTime) || currentTime < 0) return;

    currentTimeRef.current = currentTime;
    reportDuration(durationSeconds);
    const now = performance.now();
    const tracker = trackingRef.current;

    if (
      trackingEnabled &&
      isActuallyPlaying &&
      !document.hidden &&
      tracker.lastCurrentTime !== null &&
      tracker.lastWallTime > 0
    ) {
      const mediaDelta = currentTime - tracker.lastCurrentTime;
      const wallDelta = Math.max(0, (now - tracker.lastWallTime) / 1000);
      const largestNaturalStep = Math.max(2.5, wallDelta + 1.25);

      if (mediaDelta > 0 && mediaDelta <= largestNaturalStep) {
        const previousFrontier = furthestWatchedRef.current;
        const newlyWatchedSeconds = Math.max(0, currentTime - previousFrontier);

        if (newlyWatchedSeconds > 0) {
          const accepted = Math.min(
            newlyWatchedSeconds,
            mediaDelta,
            wallDelta + 0.6,
            2.5
          );

          if (accepted > 0) {
            tracker.pendingSeconds += accepted;
          }

          furthestWatchedRef.current = Math.max(previousFrontier, currentTime);

          while (tracker.pendingSeconds >= 5) flushPending(false);
        }
      }
    }

    currentTimeRef.current = currentTime;
    tracker.lastCurrentTime = currentTime;
    tracker.lastWallTime = now;
    if (ended) flushPending(true);
  }

  useEffect(() => {
    function parseMessageData(value: unknown): Record<string, any> | null {
      if (typeof value === "string") {
        try {
          return JSON.parse(value) as Record<string, any>;
        } catch {
          return null;
        }
      }
      return value && typeof value === "object" ? value as Record<string, any> : null;
    }

    function handleMessage(event: MessageEvent) {
      if (event.source !== frameRef.current?.contentWindow) return;
      const data = parseMessageData(event.data);
      if (!data) return;

      if (provider === "vimeo") {
        if (data.event === "ready") {
          for (const eventName of ["play", "pause", "ended", "timeupdate"]) {
            postToPlayer({ method: "addEventListener", value: eventName });
          }
          postToPlayer({ method: "getDuration" });
          return;
        }
        if (data.method === "getDuration" && Number.isFinite(Number(data.value))) {
          reportDuration(Number(data.value));
          return;
        }
        if (data.event === "play") {
          playingRef.current = true;
          setPlaying(true);
          resetPlaybackSample();
          return;
        }
        if (data.event === "pause") {
          playingRef.current = false;
          setPlaying(false);
          flushPending(true);
          resetPlaybackSample();
          return;
        }
        const payload = data.data && typeof data.data === "object" ? data.data as Record<string, any> : {};
        if (data.event === "timeupdate") {
          const currentTime = Number(payload.seconds);
          const durationSeconds = Number(payload.duration || durationRef.current);
          processPlaybackSample(currentTime, durationSeconds, true, false);
          return;
        }
        if (data.event === "ended") {
          playingRef.current = false;
          setPlaying(false);
          processPlaybackSample(
            Number(payload.seconds || durationRef.current),
            Number(payload.duration || durationRef.current),
            true,
            true
          );
          resetPlaybackSample();
        }
        return;
      }

      if (data.event === "onStateChange" && Number.isFinite(Number(data.info))) {
        const state = Number(data.info);
        playingRef.current = state === 1;
        setPlaying(state === 1);
        if (state === 2 || state === 0) {
          flushPending(true);
          resetPlaybackSample();
        }
        return;
      }
      if (data.event === "infoDelivery") {
        const info = data.info && typeof data.info === "object" ? data.info as Record<string, any> : {};
        const state = Number(info.playerState);
        const isActuallyPlaying = Number.isFinite(state) ? state === 1 : playingRef.current;
        if (Number.isFinite(state)) {
          playingRef.current = isActuallyPlaying;
          setPlaying(isActuallyPlaying);
        }
        const currentTime = Number(info.currentTime);
        const durationSeconds = Number(info.duration || durationRef.current);
        if (Number.isFinite(currentTime) && Number.isFinite(durationSeconds) && durationSeconds > 0) {
          processPlaybackSample(currentTime, durationSeconds, isActuallyPlaying, state === 0);
        }
      }
    }

    function handleVisibilityChange() {
      if (document.hidden) flushPending(true);
      resetPlaybackSample();
    }

    window.addEventListener("message", handleMessage);
    document.addEventListener("visibilitychange", handleVisibilityChange);
    const timer = window.setInterval(() => {
      if (!loaded) return;
      if (provider === "vimeo") {
        postToPlayer({ method: "getDuration" });
        postToPlayer({ method: "getCurrentTime" });
      } else {
        postToPlayer({ event: "listening" });
        for (const func of ["getDuration", "getCurrentTime", "getPlayerState"]) {
          postToPlayer({ event: "command", func, args: [] });
        }
      }
    }, 1000);

    return () => {
      flushPending(true);
      window.clearInterval(timer);
      window.removeEventListener("message", handleMessage);
      document.removeEventListener("visibilitychange", handleVisibilityChange);
    };
  }, [loaded, provider, trackingEnabled]);

  function scheduleControlsHide() {
    if (controlsHideTimerRef.current !== null) {
      window.clearTimeout(controlsHideTimerRef.current);
    }

    controlsHideTimerRef.current = window.setTimeout(() => {
      setControlsVisible(false);
      controlsHideTimerRef.current = null;
    }, 4000);
  }

  function showControls() {
    setControlsVisible(true);
    scheduleControlsHide();
  }

  useEffect(() => {
    if (!loaded) return;

    showControls();

    return () => {
      if (controlsHideTimerRef.current !== null) {
        window.clearTimeout(controlsHideTimerRef.current);
        controlsHideTimerRef.current = null;
      }
    };
  }, [loaded]);

  function togglePlayback() {
    if (!loaded) return;
    showControls();
    const nextPlaying = !playing;
    if (!nextPlaying) flushPending(true);
    resetPlaybackSample();
    sendPlayerCommand(nextPlaying ? "play" : "pause");
    playingRef.current = nextPlaying;
    setPlaying(nextPlaying);
  }

  async function openFullscreen() {
    showControls();
    try {
      await shellRef.current?.requestFullscreen?.();
    } catch {
      // Fullscreen may be blocked by the browser; normal playback remains available.
    }
  }

  if (!videoUrl) return null;

  return <div
    ref={shellRef}
    className="protected-video-shell"
    onContextMenu={(event) => event.preventDefault()}
    onDragStart={(event) => event.preventDefault()}
    onPointerDown={() => showControls()}
    onPointerMove={() => {
      if (!controlsVisible) showControls();
    }}
  >
    <iframe
      ref={frameRef}
      src={videoUrl}
      title={title}
      allow="autoplay; encrypted-media; gyroscope; picture-in-picture"
      referrerPolicy="strict-origin-when-cross-origin"
      allowFullScreen
      tabIndex={-1}
      onLoad={() => {
        setLoaded(true);
        resetPlaybackSample();
        window.setTimeout(() => {
          if (provider === "vimeo") {
            postToPlayer({ method: "getDuration" });
          } else {
            postToPlayer({ event: "listening" });
            postToPlayer({ event: "command", func: "getDuration", args: [] });
          }
        }, 350);
      }}
    />
    <span className="protected-video-watermark">{watermark ?? "ADIL ACADEMY • STUDENT ACCESS"}</span>
    {!playing && <button
      type="button"
      className="protected-video-start"
      onClick={togglePlayback}
      disabled={!loaded}
      aria-label={loaded ? "Play lesson video" : "Video loading"}
    >
      <Play size={30} />
      <span>{loaded ? "පාඩම ආරම්භ කරන්න" : "Video loading..."}</span>
    </button>}
    <div
      className="protected-video-controls"
      style={{
        opacity: controlsVisible ? 1 : 0,
        pointerEvents: controlsVisible ? "auto" : "none",
        transition: "opacity 220ms ease"
      }}
      onPointerDown={(event) => {
        event.stopPropagation();
        showControls();
      }}
    >
      <button
        type="button"
        onClick={togglePlayback}
        disabled={!loaded}
        aria-label={playing ? "Pause video" : "Play video"}
      >
        {playing ? <Pause size={18} /> : <Play size={18} />}
      </button>

      <button
        type="button"
        onClick={rewindTenSeconds}
        disabled={!loaded}
        aria-label="Go back 10 seconds"
        title="තත්පර 10ක් ආපස්සට"
      >
        ↶ 10s
      </button>

      <button
        type="button"
        onClick={restartVideo}
        disabled={!loaded}
        aria-label="Restart video from beginning"
        title="Video එක මුල සිට නැවත බලන්න"
      >
        ↺ Start
      </button>

      <span>
        <ShieldCheck size={14} />
        {trackingEnabled ? "WATCH TIME AUTO TRACKING" : "ADIL ACADEMY SECURE PLAYER"}
      </span>

      <button
        type="button"
        onClick={() => void openFullscreen()}
        aria-label="Open fullscreen"
      >
        <Maximize2 size={18} />
      </button>
    </div>
  </div>;
}

