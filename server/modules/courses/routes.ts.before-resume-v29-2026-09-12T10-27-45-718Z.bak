const adminVideoUnlockInput = z.object({
  userId: z.string().uuid(),
  courseId: z.string().uuid(),
  unlocked: z.boolean()
});

courseRouter.get(
  "/admin/video-unlock/search",
  asyncRoute(async (request, response) => {
    await requireRole(request, ["admin"]);
    const db = requireDatabase();
    const sr = String(request.query.sr ?? "").trim().toUpperCase().replace(/\s+/g, "");
    if (!/^SR\d+$/.test(sr)) throw new HttpError(400, "Valid SR number එකක් type කරන්න. උදා: SR527694");
    const numericPart = Number(sr.slice(2));

    const [student] = await db
      .select({
        userId: users.id,
        name: users.displayName,
        email: users.email,
        phone: users.phone,
        isActive: users.isActive,
        accountStatus: networkAccounts.status
      })
      .from(networkAccounts)
      .innerJoin(users, eq(users.id, networkAccounts.ownerUserId))
      .where(and(
        eq(networkAccounts.prefix, "SR"),
        eq(networkAccounts.numericPart, numericPart),
        eq(networkAccounts.isMainAccount, true)
      ))
      .limit(1);

    if (!student) throw new HttpError(404, "මෙම SR number එකට student account එකක් හමු නොවීය.");

    const enrollmentRows = await db
      .select({
        courseId: courses.id,
        courseTitle: courses.title,
        enrollmentStatus: enrollments.status
      })
      .from(enrollments)
      .innerJoin(courses, eq(courses.id, enrollments.courseId))
      .where(eq(enrollments.userId, student.userId))
      .orderBy(asc(enrollments.enrolledAt));

    const overrideRows = await db
      .select({ courseId: videoAccessOverrides.courseId, unlockAllVideos: videoAccessOverrides.unlockAllVideos })
      .from(videoAccessOverrides)
      .where(eq(videoAccessOverrides.userId, student.userId));
    const overrideByCourse = new Map(overrideRows.map((item) => [item.courseId, item.unlockAllVideos]));

    response.json({
      student: {
        ...student,
        accountNumber: sr,
        enrollments: enrollmentRows.map((item) => ({
          ...item,
          allVideosUnlocked: overrideByCourse.get(item.courseId) === true
        }))
      }
    });
  })
);

courseRouter.post(
  "/admin/video-unlock",
  asyncRoute(async (request, response) => {
    const admin = await requireRole(request, ["admin"]);
    const input = adminVideoUnlockInput.parse(request.body);
    const db = requireDatabase();

    const [enrollment] = await db
      .select({ id: enrollments.id })
      .from(enrollments)
      .where(and(eq(enrollments.userId, input.userId), eq(enrollments.courseId, input.courseId)))
      .limit(1);
    if (!enrollment) throw new HttpError(404, "Studentට මෙම course enrollment එකක් නැහැ.");

    const [account] = await db
      .select({ numericPart: networkAccounts.numericPart })
      .from(networkAccounts)
      .where(and(
        eq(networkAccounts.ownerUserId, input.userId),
        eq(networkAccounts.prefix, "SR"),
        eq(networkAccounts.isMainAccount, true)
      ))
      .limit(1);
    if (!account) throw new HttpError(404, "Student SR account එක හමු නොවීය.");

    await db
      .insert(videoAccessOverrides)
      .values({
        userId: input.userId,
        courseId: input.courseId,
        unlockAllVideos: input.unlocked,
        grantedBy: admin.id,
        updatedAt: new Date()
      })
      .onConflictDoUpdate({
        target: [videoAccessOverrides.userId, videoAccessOverrides.courseId],
        set: {
          unlockAllVideos: input.unlocked,
          grantedBy: admin.id,
          updatedAt: new Date()
        }
      });

    await db.insert(auditLogs).values({
      actorUserId: admin.id,
      action: input.unlocked ? "ALL_VIDEOS_UNLOCKED" : "VIDEO_LIMITS_RESTORED",
      entityType: "STUDENT_COURSE_ACCESS",
      entityId: input.userId,
      metadata: { courseId: input.courseId, accountNumber: "SR" + account.numericPart, unlocked: input.unlocked }
    });

    response.json({
      success: true,
      unlocked: input.unlocked,
      message: input.unlocked
        ? "මෙම studentට සියලු videos unlock කළා."
        : "මෙම studentට normal Daily 3 + Q & A unlock rules නැවත enable කළා."
    });
  })
);

courseRouter.get(
  "/admin/courses",
  asyncRoute(async (request, response) => {
    await requireRole(request, ["staff", "admin"]);
    const db = requireDatabase();
    const courseItems = await db.select().from(courses).orderBy(asc(courses.createdAt));
    const result = await Promise.all(courseItems.map(async (course) => {
      const sections = await db.select().from(courseSections)
        .where(eq(courseSections.courseId, course.id)).orderBy(asc(courseSections.position));
      const sectionIds = sections.map((section) => section.id);
      const lessonItems = sectionIds.length ? await db.select().from(lessons)
        .where(inArray(lessons.sectionId, sectionIds)).orderBy(asc(lessons.position)) : [];
      return { ...course, sections: sections.map((section) => ({
        ...section,
        lessons: lessonItems.filter((lesson) => lesson.sectionId === section.id)
      })) };
    }));
    response.json({ courses: result });
  })
);

courseRouter.patch(
  "/admin/courses/:id",
  asyncRoute(async (request, response) => {
    await requireRole(request, ["admin"]);
    const input = courseUpdateInput.parse(request.body);
    const db = requireDatabase();
    const { price, ...courseChanges } = input;
    const [course] = await db.update(courses).set({
      ...courseChanges,
      ...(price !== undefined ? { price: price.toFixed(2) } : {}),
      updatedAt: new Date()
    }).where(eq(courses.id, String(request.params.id))).returning();
    if (!course) { response.status(404).json({ message: "Course not found." }); return; }
    response.json({ course });
  })
);

courseRouter.put(
  "/admin/courses/:id/thumbnail",
  express.raw({ type: ["image/jpeg", "image/png", "image/webp"], limit: "5mb" }),
  asyncRoute(async (request, response) => {
    await requireRole(request, ["admin"]);
    if (!Buffer.isBuffer(request.body) || request.body.length < 10) {
      response.status(400).json({ message: "Course cover image එකක් තෝරන්න." }); return;
    }
    const db = requireDatabase();
    const [existing] = await db.select({ id: courses.id, previousKey: courses.thumbnailUrl }).from(courses)
      .where(eq(courses.id, String(request.params.id))).limit(1);
    if (!existing) { response.status(404).json({ message: "Course not found." }); return; }
    const mime = request.headers["content-type"] ?? "image/jpeg";
    const extension = mime.includes("png") ? "png" : mime.includes("webp") ? "webp" : "jpg";
    const key = `course-thumbnails/${existing.id}-${crypto.randomBytes(6).toString("hex")}.${extension}`;
    await uploadPrivateFile(key, request.body);
    await db.update(courses).set({ thumbnailUrl: key, updatedAt: new Date() }).where(eq(courses.id, existing.id));
    if (existing.previousKey && existing.previousKey !== key) {
      deletePrivateFile(existing.previousKey).catch((error) => console.warn("Old course cover cleanup failed", error));
    }
    response.json({ thumbnailUrl: `/api/courses/${existing.id}/thumbnail?v=${Date.now()}` });
  })
);

courseRouter.delete(
  "/admin/courses/:id/thumbnail",
  asyncRoute(async (request, response) => {
    await requireRole(request, ["admin"]);
    const db = requireDatabase();
    const [existing] = await db.select({ id: courses.id, key: courses.thumbnailUrl }).from(courses)
      .where(eq(courses.id, String(request.params.id))).limit(1);
    if (!existing) { response.status(404).json({ message: "Course not found." }); return; }

    await db.update(courses).set({ thumbnailUrl: null, updatedAt: new Date() }).where(eq(courses.id, existing.id));
    if (existing.key) {
      deletePrivateFile(existing.key).catch((error) => console.warn("Course cover file cleanup failed", error));
    }
    response.json({ message: "Course cover photo removed.", thumbnailUrl: null });
  })
);

