courseRouter.get(
  "/admin/courses",
  asyncRoute(async (request, response) => {
    await requireRole(request, ["staff", "admin"]);
    const db = requireDatabase();
    const courseItems = await db.select().from(courses).orderBy(asc(courses.createdAt));
    const result = await Promise.all(courseItems.map(async (course) => {
      const sections = await db.select().from(courseSections)
        .where(eq(courseSections.courseId, course.id)).orderBy(asc(courseSections.position));
      const sectionIds = sections.map((section) => section.id);
      const lessonItems = sectionIds.length ? await db.select().from(lessons)
        .where(inArray(lessons.sectionId, sectionIds)).orderBy(asc(lessons.position)) : [];
      return { ...course, sections: sections.map((section) => ({
        ...section,
        lessons: lessonItems.filter((lesson) => lesson.sectionId === section.id)
      })) };
    }));
    response.json({ courses: result });
  })
);

