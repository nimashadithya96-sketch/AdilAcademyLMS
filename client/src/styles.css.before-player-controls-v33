/* Protected lesson player: removes direct YouTube/Vimeo UI interaction and adds traceable student watermark. */
.protected-video-shell{position:relative;width:100%;aspect-ratio:16/9;border-radius:14px;overflow:hidden;background:#000;box-shadow:0 16px 45px rgba(0,0,0,.24);user-select:none;-webkit-user-select:none;isolation:isolate}
.protected-video-shell iframe{position:absolute;inset:0;width:100%;height:100%;border:0;pointer-events:none}
.protected-video-watermark{position:absolute;z-index:3;top:14%;left:5%;max-width:88%;padding:6px 9px;border:1px solid rgba(255,255,255,.2);border-radius:7px;background:rgba(0,0,0,.3);color:rgba(255,255,255,.68);font-size:8px;font-weight:900;letter-spacing:.12em;pointer-events:none;white-space:nowrap;animation:protected-watermark-move 18s ease-in-out infinite alternate}
.protected-video-start{position:absolute;z-index:5;left:50%;top:50%;transform:translate(-50%,-50%);min-width:170px;padding:15px 20px;border:1px solid rgba(255,255,255,.25);border-radius:14px;display:grid;justify-items:center;gap:8px;background:rgba(5,10,8,.82);backdrop-filter:blur(8px);color:#fff;cursor:pointer}
.protected-video-start:disabled{opacity:.65;cursor:wait}
.protected-video-start span{font-size:10px;font-weight:900}
.protected-video-controls{position:absolute;z-index:6;left:12px;right:12px;bottom:12px;min-height:42px;padding:6px 8px;border:1px solid rgba(255,255,255,.16);border-radius:11px;display:grid;grid-template-columns:38px minmax(0,1fr) 38px;gap:8px;align-items:center;background:rgba(4,8,6,.82);backdrop-filter:blur(9px)}
.protected-video-controls button{width:36px;height:34px;border:0;border-radius:8px;display:grid;place-items:center;background:rgba(255,255,255,.1);color:#fff;cursor:pointer}
.protected-video-controls button:disabled{opacity:.45;cursor:wait}
.protected-video-controls>span{display:flex;align-items:center;justify-content:center;gap:6px;min-width:0;color:rgba(255,255,255,.76);font-size:8px;font-weight:900;letter-spacing:.08em;text-align:center}
@keyframes protected-watermark-move{0%{transform:translate(0,0)}35%{transform:translate(48vw,7vh)}70%{transform:translate(12vw,25vh)}100%{transform:translate(42vw,31vh)}}
@media(max-width:600px){.protected-video-controls{left:8px;right:8px;bottom:8px}.protected-video-controls>span{font-size:7px;letter-spacing:.04em}.protected-video-start{min-width:145px;padding:12px 15px}.protected-video-watermark{font-size:7px}}
