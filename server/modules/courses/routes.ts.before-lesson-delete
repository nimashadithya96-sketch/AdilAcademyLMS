courseRouter.post(
  "/student/quizzes/:id/attempts",
  asyncRoute(async (request, response) => {
    const user = await requireAuthenticatedUser(request);
    const input = attemptInput.parse(request.body);
    const db = requireDatabase();
    const [quiz] = await db
      .select()
      .from(quizzes)
      .where(
        and(
          eq(quizzes.id, String(request.params.id)),
          eq(quizzes.isPublished, true)
        )
      )
      .limit(1);
    if (!quiz) {
      response.status(404).json({ message: "Quiz not found." });
      return;
    }
    const [enrollment] = await db
      .select({ id: enrollments.id })
      .from(enrollments)
      .where(
        and(
          eq(enrollments.userId, user.id),
          eq(enrollments.courseId, quiz.courseId),
          eq(enrollments.status, "ACTIVE")
        )
      )
      .limit(1);
    if (!enrollment) {
      response.status(403).json({ message: "Active enrollment required." });
      return;
    }
    const questions = await db
      .select()
      .from(quizQuestions)
      .where(eq(quizQuestions.quizId, quiz.id))
      .orderBy(asc(quizQuestions.position));
    if (questions.length === 0 || input.answers.length !== questions.length) {
      response.status(400).json({ message: "Answer every quiz question." });
      return;
    }
    const correct = questions.reduce(
      (total, question, index) =>
        total + (input.answers[index] === question.correctOption ? 1 : 0),
      0
    );
    const scorePercent = Math.round((correct / questions.length) * 100);
    const passed = scorePercent >= quiz.passingPercent;
    const [attempt] = await db
      .insert(quizAttempts)
      .values({
        quizId: quiz.id,
        userId: user.id,
        answers: input.answers,
        scorePercent,
        passed
      })
      .returning();
    response.status(201).json({
      attempt,
      explanations: questions.map((question) => ({
        questionId: question.id,
        correctOption: question.correctOption,
        explanation: question.explanation
      }))
    });
  })
);

courseRouter.post(
  "/admin/quizzes",
  asyncRoute(async (request, response) => {
