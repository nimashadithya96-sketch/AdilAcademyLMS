courseRouter.delete(
  "/admin/course-sections/:id",
  asyncRoute(async (request, response) => {
    await requireRole(request, ["admin"]);
    const db = requireDatabase();
    const sectionId = String(request.params.id);

    const [existing] = await db
      .select({ id: courseSections.id })
      .from(courseSections)
      .where(eq(courseSections.id, sectionId))
      .limit(1);

    if (!existing) {
      response.status(404).json({ message: "Module not found." });
      return;
    }

    const resources = await db
      .select({ resourceObjectKey: lessons.resourceObjectKey })
      .from(lessons)
      .where(eq(lessons.sectionId, sectionId));

    await db
      .delete(courseSections)
      .where(eq(courseSections.id, sectionId));

    for (const item of resources) {
      if (item.resourceObjectKey) {
        deletePrivateFile(item.resourceObjectKey).catch((error) =>
          console.warn("Module lesson resource cleanup failed", error)
        );
      }
    }

    response.json({
      success: true,
      message: "Module permanently deleted."
    });
  })
);

