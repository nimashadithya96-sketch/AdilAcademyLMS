@import url("https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Noto+Sans+Sinhala:wght@400;500;600;700&display=swap");

:root {
  color-scheme: dark;
  font-family: "Manrope", "Noto Sans Sinhala", system-ui, sans-serif;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  --bg: #050a08;
  --bg-soft: #09110e;
  --panel: #0c1712;
  --panel-light: #102019;
  --line: rgba(255, 255, 255, 0.08);
  --line-bright: rgba(139, 255, 85, 0.22);
  --text: #f7faf8;
  --muted: #94a39b;
  --green: #8bff55;
  --green-soft: #49d26d;
  --gold: #f4c86b;
  --danger: #ff7676;
  --shadow: 0 28px 90px rgba(0, 0, 0, 0.38);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  color: var(--text);
  background: var(--bg);
}

button,
a,
input {
  font: inherit;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  color: inherit;
}

.site {
  overflow: hidden;
  background:
    radial-gradient(circle at 20% -10%, rgba(59, 142, 74, 0.16), transparent 28%),
    var(--bg);
}

.section-shell,
.nav-shell {
  width: min(1180px, calc(100% - 40px));
  margin-inline: auto;
}

.public-header {
  position: absolute;
  inset: 0 0 auto;
  z-index: 20;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  background: rgba(5, 10, 8, 0.58);
  backdrop-filter: blur(18px);
}

.nav-shell {
  min-height: 80px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 11px;
}

.brand-mark {
  width: 41px;
  height: 46px;
  display: grid;
  place-items: center;
  background: linear-gradient(145deg, var(--gold), #8a5b14);
  clip-path: polygon(50% 0, 92% 18%, 84% 80%, 50% 100%, 16% 80%, 8% 18%);
  filter: drop-shadow(0 7px 13px rgba(244, 200, 107, 0.16));
}

.brand-mark::before {
  content: "";
  position: absolute;
  width: 32px;
  height: 37px;
  background: #07100c;
  clip-path: inherit;
}

.brand-mark span {
  position: relative;
  z-index: 1;
  color: var(--gold);
  font-size: 22px;
  font-weight: 800;
}

.brand-copy {
  display: flex;
  flex-direction: column;
  letter-spacing: 0.2em;
  line-height: 1;
}

.brand-copy strong {
  font-size: 18px;
  font-weight: 800;
  color: #fff;
}

.brand-copy small {
  margin-top: 5px;
  color: var(--gold);
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 0.35em;
}

/* ADIL ACADEMY - ORIGINAL BRAND LOGO */
.brand-logo-image {
  display: block;
  width: auto;
  height: 54px;
  max-width: 220px;
  object-fit: contain;
  object-position: left center;
  flex: 0 0 auto;
  filter: drop-shadow(0 7px 16px rgba(220, 182, 89, 0.14));
}

.academy-brand .brand-logo-image {
  height: 58px;
  max-width: 235px;
}

.panel-sidebar .brand-logo-image,
.sidebar-top .brand-logo-image {
  height: 52px;
}

.academy-preview-topbar .brand-logo-image {
  height: 50px;
}

@media (max-width: 650px) {
  .brand-logo-image {
    height: 44px;
    max-width: 180px;
  }

  .academy-brand .brand-logo-image {
    height: 47px;
    max-width: 190px;
  }
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 27px;
  color: #b8c4bd;
  font-size: 13px;
  font-weight: 600;
}

.nav-links a:hover {
  color: white;
}

.nav-login {
  padding-left: 24px;
  border-left: 1px solid var(--line);
}

.menu-button {
  display: none;
  border: 0;
  background: transparent;
}

.button {
  min-height: 48px;
  padding: 0 22px;
  border: 1px solid transparent;
  border-radius: 10px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  cursor: pointer;
  font-size: 13px;
  font-weight: 800;
  transition:
    transform 180ms ease,
    background 180ms ease,
    border-color 180ms ease;
}

.button:hover {
  transform: translateY(-2px);
}

.button-small {
  min-height: 42px;
  padding-inline: 17px;
  color: #061008;
  background: var(--green);
}

.button-primary {
  color: #061008;
  background: linear-gradient(135deg, #9dff6e, #60e886);
  box-shadow: 0 14px 34px rgba(98, 235, 134, 0.16);
}

.button-ghost {
  border-color: var(--line);
  color: white;
  background: rgba(255, 255, 255, 0.035);
}

.button-light {
  color: #07100c;
  background: white;
}

.button.full {
  width: 100%;
}

.hero {
  position: relative;
  padding: 166px 0 96px;
  min-height: 760px;
  display: grid;
  align-items: center;
  background:
    linear-gradient(90deg, rgba(5, 10, 8, 0.99) 0%, rgba(5, 10, 8, 0.92) 48%, rgba(5, 10, 8, 0.58) 100%),
    radial-gradient(circle at 82% 42%, rgba(73, 210, 109, 0.18), transparent 28%);
}

.hero-grid {
  position: absolute;
  inset: 0;
  opacity: 0.28;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
  background-size: 52px 52px;
  mask-image: linear-gradient(to bottom, transparent, #000 22%, #000 76%, transparent);
}

.hero-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(2px);
  pointer-events: none;
}

.hero-orb-one {
  width: 310px;
  height: 310px;
  right: 5%;
  top: 19%;
  border: 1px solid rgba(139, 255, 85, 0.12);
  box-shadow:
    0 0 0 65px rgba(139, 255, 85, 0.018),
    0 0 0 130px rgba(139, 255, 85, 0.012);
}

.hero-orb-two {
  width: 12px;
  height: 12px;
  right: 28%;
  top: 24%;
  background: var(--green);
  box-shadow: 0 0 36px 12px rgba(139, 255, 85, 0.35);
}

.hero-layout {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: 1.04fr 0.96fr;
  gap: 74px;
  align-items: center;
}

.pill,
.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--green);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.17em;
}

.pill {
  min-height: 31px;
  padding: 0 12px;
  border: 1px solid rgba(139, 255, 85, 0.17);
  border-radius: 99px;
  background: rgba(139, 255, 85, 0.055);
}

.hero-copy h1 {
  max-width: 660px;
  margin: 24px 0 22px;
  font-family: "Noto Sans Sinhala", "Manrope", sans-serif;
  font-size: clamp(48px, 5.4vw, 78px);
  line-height: 1.07;
  letter-spacing: -0.055em;
}

.hero-copy h1 span {
  display: block;
  color: transparent;
  background: linear-gradient(90deg, var(--green), #eaffdc);
  background-clip: text;
  -webkit-background-clip: text;
}

.hero-copy > p {
  max-width: 620px;
  margin: 0;
  color: #a8b5ae;
  font-size: 16px;
  line-height: 1.9;
}

.hero-actions {
  margin-top: 34px;
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.trust-row {
  margin-top: 27px;
  display: flex;
  flex-wrap: wrap;
  gap: 18px;
  color: #87958e;
  font-size: 11px;
}

.trust-row span {
  display: inline-flex;
  align-items: center;
  gap: 5px;
}

.trust-row svg {
  color: var(--green);
}

.hero-preview {
  position: relative;
  padding: 27px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 22px;
  background:
    linear-gradient(145deg, rgba(18, 37, 29, 0.96), rgba(7, 16, 12, 0.96)),
    var(--panel);
  box-shadow: var(--shadow);
  transform: perspective(1100px) rotateY(-5deg) rotateX(2deg);
}

.hero-preview::after {
  content: "";
  position: absolute;
  inset: -1px;
  z-index: -1;
  border-radius: inherit;
  background: linear-gradient(145deg, rgba(139, 255, 85, 0.24), transparent 38%);
}

.preview-glow {
  position: absolute;
  width: 140px;
  height: 140px;
  right: -30px;
  top: -30px;
  border-radius: 50%;
  background: rgba(139, 255, 85, 0.11);
  filter: blur(35px);
}

.preview-top,
.dash-card-heading,
.dashboard-welcome {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.preview-top h3 {
  margin: 7px 0 0;
  font-size: 20px;
}

.avatar {
  width: 43px;
  height: 43px;
  border: 1px solid rgba(139, 255, 85, 0.18);
  border-radius: 12px;
  display: grid;
  place-items: center;
  color: var(--green);
  background: rgba(139, 255, 85, 0.08);
  font-size: 12px;
  font-weight: 800;
}

.progress-card {
  position: relative;
  margin-top: 27px;
  padding: 24px;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 16px;
  background:
    linear-gradient(135deg, rgba(3, 8, 6, 0.58), rgba(19, 40, 29, 0.7)),
    repeating-linear-gradient(120deg, transparent 0 22px, rgba(255, 255, 255, 0.015) 22px 23px);
}

.progress-card-copy {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.progress-card-copy span {
  color: var(--muted);
  font-size: 10px;
}

.progress-card-copy strong {
  font-size: 15px;
}

.progress-value {
  position: absolute;
  right: 24px;
  top: 25px;
  color: var(--green);
  font-size: 24px;
  font-weight: 800;
}

.progress-track {
  height: 5px;
  margin-top: 21px;
  overflow: hidden;
  border-radius: 99px;
  background: rgba(255, 255, 255, 0.07);
}

.progress-track span {
  height: 100%;
  display: block;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--green-soft), var(--green));
  box-shadow: 0 0 12px rgba(139, 255, 85, 0.44);
}

.progress-track.large {
  height: 7px;
  margin-top: 22px;
}

.continue-button {
  margin-top: 20px;
  padding: 0;
  border: 0;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--green);
  background: transparent;
  font-size: 11px;
  font-weight: 800;
}

.preview-stats {
  margin-top: 15px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
}

.preview-stats div {
  min-width: 0;
  padding: 16px;
  border: 1px solid var(--line);
  border-radius: 13px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  background: rgba(255, 255, 255, 0.025);
}

.preview-stats svg {
  color: var(--gold);
}

.preview-stats span {
  color: var(--muted);
  font-size: 9px;
}

.preview-stats strong {
  font-size: 13px;
}

.proof-strip {
  border-block: 1px solid var(--line);
  background: #080f0c;
}

.proof-grid {
  min-height: 115px;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  align-items: center;
}

.proof-grid div {
  padding: 0 38px;
  border-right: 1px solid var(--line);
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.proof-grid div:first-child {
  padding-left: 0;
}

.proof-grid div:last-child {
  border-right: 0;
}

.proof-grid strong {
  color: var(--green);
  font-size: 22px;
}

.proof-grid span {
  color: var(--muted);
  font-size: 10px;
}

.section {
  padding: 112px 0;
}

.section-heading {
  max-width: 720px;
  margin: 0 auto 52px;
  text-align: center;
}

.section-heading h2,
.platform-copy h2,
.cta-card h2 {
  margin: 15px 0 16px;
  font-family: "Noto Sans Sinhala", "Manrope", sans-serif;
  font-size: clamp(32px, 4.2vw, 51px);
  line-height: 1.24;
  letter-spacing: -0.04em;
}

.section-heading p,
.platform-copy > p,
.cta-card p {
  margin: 0;
  color: var(--muted);
  font-size: 14px;
  line-height: 1.85;
}

.course-section {
  background:
    radial-gradient(circle at 50% 30%, rgba(64, 147, 78, 0.07), transparent 34%),
    var(--bg);
}

.module-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}

.module-card {
  position: relative;
  min-height: 275px;
  padding: 28px;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 17px;
  background: linear-gradient(145deg, rgba(15, 28, 22, 0.72), rgba(8, 15, 12, 0.88));
  transition:
    border-color 180ms ease,
    transform 180ms ease,
    background 180ms ease;
}

.module-card:hover {
  transform: translateY(-5px);
  border-color: rgba(139, 255, 85, 0.28);
  background: linear-gradient(145deg, rgba(18, 38, 28, 0.9), rgba(8, 15, 12, 0.95));
}

.module-number {
  position: absolute;
  right: 22px;
  top: 18px;
  color: rgba(255, 255, 255, 0.04);
  font-size: 62px;
  font-weight: 800;
}

.module-icon,
.metric-icon {
  width: 45px;
  height: 45px;
  border: 1px solid rgba(139, 255, 85, 0.18);
  border-radius: 12px;
  display: grid;
  place-items: center;
  color: var(--green);
  background: rgba(139, 255, 85, 0.065);
}

.module-icon svg {
  width: 20px;
}

.module-card h3 {
  margin: 23px 0 10px;
  font-size: 18px;
}

.module-card p {
  margin: 0;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.75;
}

.card-link,
.text-link {
  margin-top: 24px;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  color: var(--green);
  font-size: 11px;
  font-weight: 800;
}

.platform-section {
  position: relative;
  border-block: 1px solid var(--line);
  background:
    linear-gradient(110deg, rgba(10, 20, 16, 0.98), rgba(8, 14, 12, 0.93)),
    var(--bg-soft);
}

.platform-layout,
.network-layout {
  display: grid;
  grid-template-columns: 0.83fr 1.17fr;
  gap: 88px;
  align-items: center;
}

.platform-copy h2 {
  font-size: clamp(32px, 3.7vw, 47px);
}

.feature-list {
  margin-top: 30px;
  display: grid;
  gap: 14px;
}

.feature-list div {
  display: flex;
  align-items: center;
  gap: 12px;
  color: #c4cec8;
  font-size: 12px;
}

.feature-list div span {
  width: 26px;
  height: 26px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  color: var(--green);
  background: rgba(139, 255, 85, 0.08);
}

.platform-copy .text-link {
  margin-top: 30px;
}

.platform-panel {
  min-height: 420px;
  padding: 15px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 22px;
  display: grid;
  grid-template-columns: 170px 1fr;
  gap: 10px;
  background: #070c0a;
  box-shadow: var(--shadow);
  transform: perspective(1200px) rotateY(-4deg);
}

.panel-sidebar {
  padding: 20px 16px;
  border-radius: 15px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  background: #0b1510;
}

.panel-sidebar .brand {
  margin-bottom: 27px;
  transform: scale(0.77);
  transform-origin: left center;
}

.panel-sidebar > span {
  min-height: 39px;
  padding: 0 11px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  gap: 10px;
  color: #75847b;
  font-size: 9px;
}

.panel-sidebar > span.active-line {
  color: var(--green);
  background: rgba(139, 255, 85, 0.07);
}

.panel-main {
  min-width: 0;
  padding: 26px;
  border-radius: 15px;
  background:
    radial-gradient(circle at 50% 40%, rgba(139, 255, 85, 0.07), transparent 32%),
    #0d1813;
}

.mini-label {
  color: #8c9a92;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 0.15em;
}

.chart-bars {
  height: 200px;
  margin: 30px 0 21px;
  padding: 0 8px;
  border-bottom: 1px solid var(--line);
  display: flex;
  align-items: flex-end;
  gap: 13px;
  background-image: linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px);
  background-size: 100% 50px;
}

.chart-bars span {
  flex: 1;
  max-width: 35px;
  border-radius: 6px 6px 0 0;
  background: linear-gradient(to top, rgba(64, 215, 102, 0.15), var(--green));
  box-shadow: 0 0 16px rgba(139, 255, 85, 0.09);
}

.panel-course-row {
  padding: 13px;
  border: 1px solid var(--line);
  border-radius: 11px;
  display: flex;
  align-items: center;
  gap: 12px;
  background: rgba(255, 255, 255, 0.025);
}

.course-play {
  width: 35px;
  height: 35px;
  flex: 0 0 auto;
  border-radius: 9px;
  display: grid;
  place-items: center;
  color: #061008;
  background: var(--green);
}

.panel-course-row > div {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.panel-course-row strong {
  overflow: hidden;
  font-size: 10px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.panel-course-row > div span,
.course-time {
  color: var(--muted);
  font-size: 8px;
}

.course-time {
  margin-left: auto;
}

.network-section {
  background:
    radial-gradient(circle at 18% 52%, rgba(77, 191, 92, 0.09), transparent 25%),
    var(--bg);
}

.network-layout {
  grid-template-columns: 1.05fr 0.95fr;
}

.network-visual {
  position: relative;
  min-height: 460px;
  padding: 54px;
  border: 1px solid var(--line);
  border-radius: 24px;
  background:
    linear-gradient(rgba(255, 255, 255, 0.024) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.024) 1px, transparent 1px),
    linear-gradient(145deg, #0d1913, #070d0a);
  background-size:
    31px 31px,
    31px 31px,
    auto;
  box-shadow: var(--shadow);
}

.network-node {
  position: relative;
  z-index: 2;
  width: 128px;
  min-height: 72px;
  margin-inline: auto;
  border: 1px solid rgba(139, 255, 85, 0.22);
  border-radius: 14px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6px;
  background: rgba(12, 28, 19, 0.96);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.26);
}

.network-node span {
  color: var(--green);
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 0.13em;
}

.network-node strong {
  font-size: 12px;
}

.network-root {
  width: 145px;
  min-height: 84px;
  background: linear-gradient(145deg, rgba(139, 255, 85, 0.16), rgba(10, 24, 16, 0.98));
}

.network-lines {
  width: 52%;
  height: 60px;
  margin: 0 auto;
  border-inline: 1px solid rgba(139, 255, 85, 0.27);
  border-top: 1px solid rgba(139, 255, 85, 0.27);
  transform: translateY(34px);
}

.network-lines::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 138px;
  width: 1px;
  height: 34px;
  background: rgba(139, 255, 85, 0.27);
}

.network-children {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
}

.network-left {
  border-color: rgba(139, 255, 85, 0.28);
}

.network-right {
  border-color: rgba(244, 200, 107, 0.28);
}

.network-right span {
  color: var(--gold);
}

.network-balance {
  margin-top: 48px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.network-balance div {
  padding: 18px;
  border: 1px solid var(--line);
  border-radius: 12px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(255, 255, 255, 0.025);
}

.network-balance span {
  color: var(--muted);
  font-size: 9px;
}

.network-balance strong {
  color: var(--green);
  font-size: 14px;
}

.network-tags {
  margin-top: 28px;
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
}

.network-tags span {
  min-height: 40px;
  padding: 0 13px;
  border: 1px solid var(--line);
  border-radius: 9px;
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: #c7d1cb;
  background: rgba(255, 255, 255, 0.025);
  font-size: 10px;
}

.network-tags svg {
  color: var(--green);
}

